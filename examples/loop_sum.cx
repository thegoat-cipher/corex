// CoreX example: control flow and integer semantics.
//
// Sums the integers 1..=10 with a `while` loop, skipping 4 with `continue`,
// then exits with the sum as the process status.
//
// Expected exit status: 51 (1 + 2 + 3 + 5 + 6 + 7 + 8 + 9 + 10)

fn main() -> i32 {
    let mut index: usize = 0;
    let mut sum: usize = 0;

    while index < 10 {
        index = index + 1;
        if index == 4 {
            continue;
        }
        sum = sum + index;
    }

    return sum as i32;
}
