// A small tokenizer showing the data structures a compiler frontend needs:
// enums, structs, slices, strings, `const`, dynamic arrays, and assertions.

enum TokenKind { Word, Punct }

struct Token { kind: TokenKind, start: usize, len: usize }

const SOURCE: str = "fn main() { return 0; }";

fn is_space(c: u8) -> bool {
    return c == 32 || c == 10 || c == 9;
}

fn is_punct(c: u8) -> bool {
    return c == 40 || c == 41 || c == 123 || c == 125 || c == 59;
}

fn main() -> i32 {
    assert(len(SOURCE) > 0, "source is empty");
    let mut tokens: vec<Token> = vec_new(8);
    let mut i: usize = 0;
    while i < len(SOURCE) {
        let c: u8 = SOURCE[i];
        if is_space(c) {
            i += 1;
        } else if is_punct(c) {
            vec_push(&mut tokens, Token { kind: TokenKind::Punct, start: i, len: 1 });
            i += 1;
        } else {
            let start: usize = i;
            while i < len(SOURCE) && !is_space(SOURCE[i]) && !is_punct(SOURCE[i]) {
                i += 1;
            }
            vec_push(&mut tokens, Token { kind: TokenKind::Word, start: start, len: i - start });
        }
    }

    print(len(tokens));
    print(tokens[0].kind as i32);
    print(SOURCE[tokens[0].start..tokens[0].start + tokens[0].len]);
    print(tokens[1].len);
    print(tokens[8].kind as i32);
    vec_free(&mut tokens);
    return 0;
}
