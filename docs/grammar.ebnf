(*
 * CoreX v0.2 grammar (EBNF).
 *
 * This grammar is normative and matches compiler/src/parser.rs. Where the
 * parser is intentionally more permissive than the grammar (for error recovery),
 * semantic analysis still enforces the rule; those cases are marked [semantic].
 *
 * Terminals are quoted literals or UPPERCASE classes. "{ x }" is repetition,
 * "[ x ]" is optional, "|" is alternation.
 *)

program        = { item } EOF ;
item           = function | global | const_decl | import_decl
               | enum_decl | struct_decl ;

function       = "fn" IDENT "(" [ param_list ] ")" [ "->" type ] block ;
param_list     = param { "," param } ;
param          = IDENT ":" type ;

global         = "static" [ "mut" ] IDENT ":" type "=" expression ";" ;
const_decl     = "const" IDENT ":" type "=" expression ";" ;
import_decl    = "import" STRING ";" ;

enum_decl      = "enum" IDENT "{" [ variant { "," variant } [ "," ] ] "}" ;
variant        = IDENT [ "=" expression ] ;

struct_decl    = "struct" IDENT "{" [ field_decl { "," field_decl } [ "," ] ] "}" ;
field_decl     = IDENT ":" type ;

type           = primitive
               | "[" type ";" INTEGER "]"
               | "[" type "]"
               | "vec" "<" type ">"
               | "*" [ "mut" ] type
               | IDENT ;

primitive      = "i8"  | "i16" | "i32" | "i64"
               | "u8"  | "u16" | "u32" | "u64"
               | "usize" | "isize" | "bool"
               | "char" | "f32" | "f64" | "str" ;

block          = "{" { statement } "}" ;

statement      = let_stmt
               | if_stmt
               | while_stmt
               | loop_stmt
               | break_stmt
               | continue_stmt
               | return_stmt
               | unsafe_stmt
               | block
               | assignment
               | expression_stmt
               | empty_stmt ;

let_stmt       = "let" [ "mut" ] IDENT [ ":" type ] "=" expression ";" ;
if_stmt        = "if" expression block [ "else" ( if_stmt | block ) ] ;
while_stmt     = "while" expression block ;
loop_stmt      = "loop" block ;
break_stmt     = "break" ";"
continue_stmt  = "continue" ";"
return_stmt    = "return" [ expression ] ";" ;
unsafe_stmt    = "unsafe" block ;
empty_stmt     = ";" ;

(* [semantic] the left side must be a mutable place expression: identifier,
   pointer dereference, array/slice index, or struct field. *)
assignment     = expression [ compound_op ] expression ";" ;
compound_op    = "+=" | "-=" | "*=" | "/=" | "%="
               | "&=" | "|=" | "^=" | "<<=" | ">>=" ;

expression_stmt = expression ";" ;

(* ----- expressions: lowest to highest precedence ----- *)

expression     = or_expr ;

or_expr        = and_expr { "||" and_expr } ;
and_expr       = bitor_expr { "&&" bitor_expr } ;
bitor_expr     = bitxor_expr { "|" bitxor_expr } ;
bitxor_expr    = bitand_expr { "^" bitand_expr } ;
bitand_expr    = equality { "&" equality } ;
equality       = relational { ( "==" | "!=" ) relational } ;
relational     = shift { ( "<" | "<=" | ">" | ">=" ) shift } ;
shift          = additive { ( "<<" | ">>" ) additive } ;
additive       = multiplicative { ( "+" | "-" ) multiplicative } ;
multiplicative = cast { ( "*" | "/" | "%" ) cast } ;

cast           = unary { "as" type } ;

unary          = "-" unary
               | "!" unary
               | "&" unary
               | "&" "mut" unary
               | "*" unary
               | postfix ;

postfix        = primary { call_suffix | index_suffix | range_suffix | field_suffix } ;
call_suffix    = "(" [ arg_list ] ")" ;
index_suffix   = "[" expression "]" ;
range_suffix   = "[" [ expression ] ".." [ expression ] "]" ;
field_suffix   = "." IDENT ;
arg_list       = expression { "," expression } ;

primary        = INTEGER
               | FLOAT
               | STRING
               | CHAR
               | "true"
               | "false"
               | IDENT [ "::" IDENT ]
               | struct_literal
               | "(" expression ")"
               | "[" array_literal "]" ;

(* `IDENT "{" IDENT ":"` is a struct literal; this lookahead keeps block
   statements such as `if flag { ... }` unambiguous. An empty literal is not
   accepted. *)
struct_literal = IDENT "{" IDENT ":" expression
                 { "," IDENT ":" expression } [ "," ] "}" ;

array_literal  = expression [ "," [ expression { "," expression } [ "," ] ] ]
               | expression ";" INTEGER ;

(* ----- lexical classes ----- *)

INTEGER        = dec_lit | hex_lit | bin_lit | oct_lit ;
dec_lit        = DIGIT { DIGIT | "_" } ;
hex_lit        = "0x" HEXDIGIT { HEXDIGIT | "_" } ;
bin_lit        = "0b" BINDIGIT { BINDIGIT | "_" } ;
oct_lit        = "0o" OCTDIGIT { OCTDIGIT | "_" } ;

FLOAT          = dec_lit ( "." DIGIT { DIGIT | "_" } [ exponent ]
                         | exponent ) ;
exponent       = ( "e" | "E" ) [ "+" | "-" ] DIGIT { DIGIT | "_" } ;

STRING         = '"' { string_char | escape } '"' ;
CHAR           = "'" ( string_char | escape ) "'" ;
escape         = "\" ( "n" | "t" | "r" | "0" | "\" | '"' | "'" | "\x" HEXDIGIT HEXDIGIT ) ;

IDENT          = ( "_" | ALPHA ) { "_" | ALPHA | DIGIT } ;

ALPHA          = "a"…"z" | "A"…"Z" ;
DIGIT          = "0"…"9" ;
HEXDIGIT       = DIGIT | "a"…"f" | "A"…"F" ;
BINDIGIT       = "0" | "1" ;
OCTDIGIT       = "0"…"7" ;

(* Comments and whitespace are trivia:
   line comment   = "//" { any byte except newline } ;
   block comment  = "/*" { any byte } "*/" ;  (not nested)
*)

(* ----- reserved words (cannot be identifiers) -----

   fn import static const enum struct let mut if else while loop break
   continue return unsafe as true false
   i8 i16 i32 i64 u8 u16 u32 u64 usize isize bool char f32 f64 str vec

   Builtin function names, reserved everywhere (functions, bindings, parameters):
   syscall alloc free print len vec_new vec_push vec_free vec_slice
   read_file write_file panic assert
*)
