// CoreX bootstrap type model. Kept separate from the AST so the type checker
// and code generator share one representation without duplicating layout rules.

enum K {
    Void, Bool, I8, I16, I32, I64, U8, U16, U32, U64, Usize, Isize,
    F32, F64, Char, Ptr, Array, Str, CStr, Named, Struct, Enum, Slice, Vec,
    Fn
}

struct Type {
    kind: K,
    elem: *mut Type,
    len: usize,
    len_expr: *mut Expr,
    decl: *mut Decl,
    mutable: bool,
    name: str,
    // Function types: `params`/`ret`/`variadic` describe the signature and
    // `next` chains parameter types. Unused by every other kind.
    next: *mut Type,
    params: *mut Type,
    ret: *mut Type,
    variadic: bool,
}

fn type_new(a: *mut Arena, kind: K) -> *mut Type {
    let t: *mut Type = rt_alloc(a, sizeof(Type)) as *mut Type;
    unsafe {
        (*t).kind = kind;
        (*t).elem = null;
        (*t).len = 0;
        (*t).len_expr = null;
        (*t).decl = null;
        (*t).mutable = false;
        (*t).name = "";
        (*t).next = null;
        (*t).params = null;
        (*t).ret = null;
        (*t).variadic = false;
    }
    return t;
}

fn type_ptr(a: *mut Arena, elem: *mut Type, mutable: bool) -> *mut Type {
    let t: *mut Type = type_new(a, K::Ptr);
    unsafe {
        (*t).elem = elem;
        (*t).mutable = mutable;
    }
    return t;
}

fn type_array(a: *mut Arena, elem: *mut Type, n: usize, len_expr: *mut Expr) -> *mut Type {
    let t: *mut Type = type_new(a, K::Array);
    unsafe {
        (*t).elem = elem;
        (*t).len = n;
        (*t).len_expr = len_expr;
    }
    return t;
}

fn type_vec(a: *mut Arena, elem: *mut Type) -> *mut Type {
    let t: *mut Type = type_new(a, K::Vec);
    unsafe {
        (*t).elem = elem;
    }
    return t;
}

fn type_fn(a: *mut Arena, params: *mut Type, ret: *mut Type, variadic: bool) -> *mut Type {
    let t: *mut Type = type_new(a, K::Fn);
    unsafe {
        (*t).params = params;
        (*t).ret = ret;
        (*t).variadic = variadic;
    }
    return t;
}


// A struct whose layout LLVM reproduces exactly: no union, no packed, no
// explicit alignment, no bitfields, and every field type is itself plain.
// Non-plain aggregates are lowered to `[size x i8]` and accessed through the
// byte offsets computed by semantic analysis; their static initializers are
// rejected by semantic analysis.
fn struct_plain(d: *mut Decl) -> bool {
    unsafe {
    if d == null {
        return true;
    }
    if (*d).is_union || (*d).is_packed || (*d).explicit_align > 0 {
        return false;
    }
    let mut f: *mut Field = (*d).fields;
    while f != null {
        if (*f).bit_width > 0 {
            return false;
        }
        if !type_plain((*f).ty) {
            return false;
        }
        f = (*f).next;
    }
    return true;

    }
}

fn type_plain(t: *mut Type) -> bool {
    unsafe {
    if t == null {
        return true;
    }
    let k: K = (*t).kind;
    if k == K::Struct {
        return struct_plain((*t).decl);
    }
    if k == K::Array {
        return type_plain((*t).elem);
    }
    return true;

    }
}
