}

");
    rt_s(hp, "define weak i32 @memcmp(ptr %a, ptr %b, i64 %n) {\nentry:\n  br label %loop\nloop:\n  %i = phi i64 [ 0, %entry ], [ %next, %more ]\n  %cond = icmp ult i64 %i, %n\n  br i1 %cond, label %body, label %equal\nbody:\n  %ap = getelementptr inbounds i8, ptr %a, i64 %i\n  %av = load i8, ptr %ap, align 1\n  %bp = getelementptr inbounds i8, ptr %b, i64 %i\n  %bv = load i8, ptr %bp, align 1\n  %same = icmp eq i8 %av, %bv\n  br i1 %same, label %more, label %diff\nmore:\n  %next = add i64 %i, 1\n  br label %loop\ndiff:\n  %ax = zext i8 %av to i32\n  %bx = zext i8 %bv to i32\n  %d = sub i32 %ax, %bx\n  ret i32 %d\nequal:\n  ret i32 0\n}\n\n");
