    rt_s(hp, "define weak void @memset(ptr %dst, i8 %value, i64 %n) {\nentry:\n  br label %loop\nloop:\n  %i = phi i64 [ 0, %entry ], [ %next, %body ]\n  %cond = icmp ult i64 %i, %n\n  br i1 %cond, label %body, label %done\nbody:\n  %p = getelementptr inbounds i8, ptr %dst, i64 %i\n  store i8 %value, ptr %p, align 1\n  %next = add i64 %i, 1\n  br label %loop\ndone:\n  ret void\n}\n\n");
    rt_s(hp, "define weak ptr @memcpy(ptr %dst, ptr %src, i64 %n) {\nentry:\n  br label %loop\nloop:\n  %i = phi i64 [ 0, %entry ], [ %next, %body ]\n  %cond = icmp ult i64 %i, %n\n  br i1 %cond, label %body, label %done\nbody:\n  %s = getelementptr inbounds i8, ptr %src, i64 %i\n  %b = load i8, ptr %s, align 1\n  %d = getelementptr inbounds i8, ptr %dst, i64 %i\n  store i8 %b, ptr %d, align 1\n  %next = add i64 %i, 1\n  br label %loop\ndone:\n  ret ptr %dst\n}\n\n");
    rt_s(hp, "define weak ptr @memmove(ptr %dst, ptr %src, i64 %n) {
entry:
  %di = ptrtoint ptr %dst to i64
