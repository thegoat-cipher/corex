    }
    if (*cg).used_assert {
        rt_s(hp, "define internal void @_cx_assert(i1 %c, ptr %m, i64 %n) {\nentry:\n  br i1 %c, label %ok, label %fail\nfail:\n  call void @_cx_fatal(ptr %m, i64 %n)\n  unreachable\nok:\n  ret void\n}\n\n");
