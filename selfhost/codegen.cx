fn gen_entry(cg: *mut Cg, out: *mut Buf) {
    unsafe {
    // `--hosted` leaves `_start` to the C runtime; shared/static-library
    // output has no entry point at all.
    if (*cg).hosted || !(*cg).make_entry {
        return;
    }
    let m: *mut Decl = sem_find((*cg).sem, "main");
    let s: *mut Decl = sem_find((*cg).sem, "_start");
    if s != null {
        return;
    }
    if m == null {
        return;
    }
    if (*m).nparams == 3 {
        rt_s(out, "module asm \".globl _start\"\nmodule asm \"_start:\"\nmodule asm \"  movq %rsp, %rdi\"\nmodule asm \"  andq $-16, %rsp\"\nmodule asm \"  call __corex_entry\"\nmodule asm \"  hlt\"\n");
        rt_s(out, "define void @__corex_entry(i64 %sp) #0 {\nentry:\n  %argc_p = inttoptr i64 %sp to ptr\n  %argc = load i32, ptr %argc_p, align 4\n  %argv_off = add i64 %sp, 8\n  %argv = inttoptr i64 %argv_off to ptr\n  %argc64 = sext i32 %argc to i64\n  %env_idx = add i64 %argc64, 2\n  %env_off = mul i64 %env_idx, 8\n  %env_addr = add i64 %sp, %env_off\n  %envp = inttoptr i64 %env_addr to ptr\n  %r = call i32 @main(i32 %argc, ptr %argv, ptr %envp)\n  %ext = sext i32 %r to i64\n  %e = call i64 @_cx_syscall(i64 60, i64 %ext, i64 0, i64 0, i64 0, i64 0, i64 0)\n  unreachable\n}\n\n");
    } else {
        rt_s(out, "define void @_start() #0 {\nentry:\n  %r = call i32 @main()\n  %ext = sext i32 %r to i64\n  %e = call i64 @_cx_syscall(i64 60, i64 %ext, i64 0, i64 0, i64 0, i64 0, i64 0)\n  unreachable\n}\n\n");
    }
    (*cg).used_syscall = true;
    }
}


fn cg_init(a: *mut Arena, sem: *mut Sem, sanitize: bool, hosted: bool,
           make_entry: bool) -> *mut Cg {
    let cg: *mut Cg = rt_alloc(a, sizeof(Cg)) as *mut Cg;
    unsafe {
        (*cg).a = a;
        (*cg).sem = sem;
        (*cg).str_ty = type_new(a, K::Str);
        (*cg).types = cg_buf(cg);
        (*cg).globals = cg_buf(cg);
        (*cg).strings = cg_buf(cg);
        (*cg).decls = cg_buf(cg);
        (*cg).defs = cg_buf(cg);
        (*cg).strs = 0;
        (*cg).used_syscall = true;
        (*cg).used_alloc = false;
        (*cg).used_free = false;
        (*cg).used_print_i64 = false;
        (*cg).used_print_u64 = false;
        (*cg).used_print_bool = false;
        (*cg).used_print_char = false;
        (*cg).used_print_str = false;
        (*cg).used_print_f64 = false;
        (*cg).used_file_io = false;
        (*cg).used_fatal = false;
        (*cg).used_cstr_len = false;
        (*cg).used_cstr_str = false;
        (*cg).used_assert = false;
        (*cg).sanitize = sanitize;
        (*cg).hosted = hosted;
        (*cg).make_entry = make_entry;
        if sanitize {
            rt_s((*cg).decls, "declare {i8, i1} @llvm.sadd.with.overflow.i8(i8, i8)\ndeclare {i8, i1} @llvm.ssub.with.overflow.i8(i8, i8)\ndeclare {i8, i1} @llvm.smul.with.overflow.i8(i8, i8)\n");
            rt_s((*cg).decls, "declare {i16, i1} @llvm.sadd.with.overflow.i16(i16, i16)\ndeclare {i16, i1} @llvm.ssub.with.overflow.i16(i16, i16)\ndeclare {i16, i1} @llvm.smul.with.overflow.i16(i16, i16)\n");
            rt_s((*cg).decls, "declare {i32, i1} @llvm.sadd.with.overflow.i32(i32, i32)\ndeclare {i32, i1} @llvm.ssub.with.overflow.i32(i32, i32)\ndeclare {i32, i1} @llvm.smul.with.overflow.i32(i32, i32)\n");
            rt_s((*cg).decls, "declare {i64, i1} @llvm.sadd.with.overflow.i64(i64, i64)\ndeclare {i64, i1} @llvm.ssub.with.overflow.i64(i64, i64)\ndeclare {i64, i1} @llvm.smul.with.overflow.i64(i64, i64)\n\n");

        }
    }

    return cg;
}

fn cg_prelude(cg: *mut Cg) {
    unsafe {
        gen_types(cg);
        gen_globals(cg);
        let mut g: *mut Decl = (*(*cg).sem).globals;
        while g != null {
            if (*g).kind == D::Func {
                gen_fn(cg, g);
            }
            g = (*g).next;
        }
    }
}

fn cg_module(cg: *mut Cg, ep: *mut Buf) -> str {
    unsafe {

    gen_helpers(cg);
    let mut out: Buf = rt_buf((*cg).a);
    let op: *mut Buf = &mut out;
    rt_s(op, "; CoreX module: corexc\nsource_filename = \"corexc\"\ntarget triple = \"x86_64-unknown-linux-gnu\"\n\n");
    rt_s(op, rt_view((*cg).types));
    rt_s(op, rt_view((*cg).decls));
    rt_s(op, rt_view((*cg).strings));
    rt_s(op, rt_view((*cg).globals));
    rt_s(op, rt_view((*cg).defs));
    rt_s(op, rt_view(ep));
    rt_s(op, "attributes #0 = { alignstack=16 }\n");
    return rt_view(op);
    }
}

fn cg_run_ex(a: *mut Arena, d: *mut Diags, srcs: *mut SrcList, prog: *mut Program,
             sem: *mut Sem, sanitize: bool, hosted: bool, make_entry: bool) -> str {
    unsafe {
    let cg: *mut Cg = cg_init(a, sem, sanitize, hosted, make_entry);
    cg_prelude(cg);
    let mut entry: Buf = rt_buf(a);
    let ep: *mut Buf = &mut entry;
    gen_entry(cg, ep);
    return cg_module(cg, ep);
    }
}

fn cg_run(a: *mut Arena, d: *mut Diags, srcs: *mut SrcList, prog: *mut Program, sem: *mut Sem) -> str {
    return cg_run_ex(a, d, srcs, prog, sem, false, false, true);
}

// `corexc test`: emit `_start` that calls every `test_*` function, prints
// `test <name> ... ok|FAILED`, and exits nonzero when any test fails.
fn cg_test_entry(cg: *mut Cg, out: *mut Buf) {
    unsafe {
    let mut count: i32 = 0;
    let mut g: *mut Decl = (*(*cg).sem).globals;
    while g != null {
        if (*g).kind == D::Func && (*g).body != null && rt_starts((*g).name, "test_") {
            if (*g).ty == null || (*(*g).ty).kind != K::Bool {
                let mut mb: Buf = rt_buf((*cg).a);
                let mbp: *mut Buf = &mut mb;
                rt_s(mbp, "test `");
                rt_s(mbp, (*g).name);
                rt_s(mbp, "` must return `bool` (true = pass)");
                diag_add((*(*cg).sem).d, (*cg).a, (*g).file, (*g).line, (*g).col, rt_view(mbp));
            }
            count = count + 1;
        }
        g = (*g).next;
    }
    if count == 0 {
        diag_add((*(*cg).sem).d, (*cg).a, 0, 0, 0, "no tests found: define `fn test_something() -> bool`");
        return;
    }
    rt_s(out, "define void @_start() #0 {\nentry:\n  %failures = alloca i32, align 4\n  store i32 0, ptr %failures, align 4\n");
    let mut idx: i32 = 0;
    g = (*(*cg).sem).globals;
    while g != null {
        if (*g).kind == D::Func && (*g).body != null && rt_starts((*g).name, "test_") {
            let mut okb: Buf = rt_buf((*cg).a);
            let okp: *mut Buf = &mut okb;
            rt_s(okp, "test ");
            rt_s(okp, (*g).name);
            rt_s(okp, " ... ok\n");
            let ok_msg: str = rt_view(okp);
            let ok_id: i32 = add_string(cg, ok_msg);
            let mut fb: Buf = rt_buf((*cg).a);
            let fbp: *mut Buf = &mut fb;
            rt_s(fbp, "test ");
            rt_s(fbp, (*g).name);
            rt_s(fbp, " ... FAILED\n");
            let fail_msg: str = rt_view(fbp);
            let fail_id: i32 = add_string(cg, fail_msg);
            rt_s(out, "  %r");
            rt_i(out, idx as i64);
            rt_s(out, " = call i1 @");
            rt_s(out, (*g).name);
            rt_s(out, "()\n  br i1 %r");
            rt_i(out, idx as i64);
            rt_s(out, ", label %pass");
            rt_i(out, idx as i64);
            rt_s(out, ", label %fail");
            rt_i(out, idx as i64);
            rt_s(out, "\npass");
            rt_i(out, idx as i64);
            rt_s(out, ":\n  %pok");
            rt_i(out, idx as i64);
            rt_s(out, " = ptrtoint ptr @.str");
            rt_i(out, ok_id as i64);
            rt_s(out, " to i64\n  %pw");
            rt_i(out, idx as i64);
            rt_s(out, " = call i64 @_cx_syscall(i64 1, i64 1, i64 %pok");
            rt_i(out, idx as i64);
            rt_s(out, ", i64 ");
            rt_i(out, len(ok_msg) as i64);
            rt_s(out, ", i64 0, i64 0, i64 0)\n  br label %next");
            rt_i(out, idx as i64);
            rt_s(out, "\nfail");
            rt_i(out, idx as i64);
            rt_s(out, ":\n  %fp");
            rt_i(out, idx as i64);
            rt_s(out, " = ptrtoint ptr @.str");
            rt_i(out, fail_id as i64);
            rt_s(out, " to i64\n  %fw");
            rt_i(out, idx as i64);
            rt_s(out, " = call i64 @_cx_syscall(i64 1, i64 1, i64 %fp");
            rt_i(out, idx as i64);
            rt_s(out, ", i64 ");
            rt_i(out, len(fail_msg) as i64);
            rt_s(out, ", i64 0, i64 0, i64 0)\n  %fc");
            rt_i(out, idx as i64);
            rt_s(out, " = load i32, ptr %failures, align 4\n  %fn");
            rt_i(out, idx as i64);
            rt_s(out, " = add i32 %fc");
            rt_i(out, idx as i64);
            rt_s(out, ", 1\n  store i32 %fn");
            rt_i(out, idx as i64);
            rt_s(out, ", ptr %failures, align 4\n  br label %next");
            rt_i(out, idx as i64);
            rt_s(out, "\nnext");
            rt_i(out, idx as i64);
            rt_s(out, ":\n");
            idx = idx + 1;
        }
        g = (*g).next;
    }
    rt_s(out, "  %fc = load i32, ptr %failures, align 4\n  %bad = icmp ne i32 %fc, 0\n  %code = select i1 %bad, i32 1, i32 0\n  %ext = sext i32 %code to i64\n  %exit = call i64 @_cx_syscall(i64 60, i64 %ext, i64 0, i64 0, i64 0, i64 0, i64 0)\n  unreachable\n}\n\n");
    }
}

fn cg_run_tests(a: *mut Arena, d: *mut Diags, srcs: *mut SrcList, prog: *mut Program, sem: *mut Sem) -> str {
    unsafe {
    let cg: *mut Cg = cg_init(a, sem, false, false, true);
    cg_prelude(cg);
    let mut entry: Buf = rt_buf(a);
    let ep: *mut Buf = &mut entry;
    cg_test_entry(cg, ep);
    return cg_module(cg, ep);
    }
}
