        rt_i(hp, ninf as i64);
        rt_s(hp, ", ptr @.str");
        rt_i(hp, inf as i64);
        rt_s(hp, "\n  %in = select i1 %neginf, i64 5, i64 4\n  %ipn = ptrtoint ptr %ip to i64\n  %iw = call i64 @_cx_syscall(i64 1, i64 1, i64 %ipn, i64 %in, i64 0, i64 0, i64 0)\n  ret void\nfinite:\n  %neg = icmp slt i64 %bits, 0\n  br i1 %neg, label %negative, label %positive\nnegative:\n  %mp = ptrtoint ptr @.str");
        rt_i(hp, minus as i64);
        rt_s(hp, " to i64\n  %mw = call i64 @_cx_syscall(i64 1, i64 1, i64 %mp, i64 1, i64 0, i64 0, i64 0)\n  %magn = fneg double %value\n  br label %emit\npositive:\n  br label %emit\nemit:\n  %x = phi double [ %magn, %negative ], [ %value, %positive ]\n  %toolarge = fcmp oge double %x, 1.0e18\n  br i1 %toolarge, label %fail, label %ok\nfail:\n  call void @_cx_fatal(ptr @.str");
        rt_i(hp, huge as i64);
        rt_s(hp, ", i64 ");
        rt_i(hp, len("corex: float too large to print\n") as i64);
        rt_s(hp, ")\n  unreachable\nok:\n  %i = fptoui double %x to i64\n  %fi = uitofp i64 %i to double\n  %frac = fsub double %x, %fi\n  %scaled = fmul double %frac, 1000000.0\n  %f6 = fptoui double %scaled to i64\n  call void @_cx_put_u64(i64 %i)\n  %dp = ptrtoint ptr @.str");
        rt_i(hp, dot as i64);
        rt_s(hp, " to i64\n  %dw = call i64 @_cx_syscall(i64 1, i64 1, i64 %dp, i64 1, i64 0, i64 0, i64 0)\n  call void @_cx_put_pad6(i64 %f6)\n  call void @_cx_newline()\n  ret void\n}\n\n");
    }
    if (*cg).used_cstr_len || (*cg).used_cstr_str {
        rt_s(hp, "define internal i64 @_cx_cstr_len(ptr %s) {\nentry:\n  br label %loop\nloop:\n  %i = phi i64 [ 0, %entry ], [ %next, %body ]\n  %p = getelementptr inbounds i8, ptr %s, i64 %i\n  %c = load i8, ptr %p, align 1\n  %stop = icmp eq i8 %c, 0\n  br i1 %stop, label %done, label %body\nbody:\n  %next = add i64 %i, 1\n  br label %loop\ndone:\n  ret i64 %i\n}\n\n");
