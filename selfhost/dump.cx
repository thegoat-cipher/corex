// Differential dumps: tokens and a normalized AST shape.
//
// `dump-tokens` prints `<kind> <line>:<col> <lexeme>` for every token.
// `dump-ast` prints item and signature lines plus a histogram of statement and
// expression kinds. The same schema is emitted by tests/selfhosting/dump_oracle.rs
// (which links the Rust reference compiler) so the corpus can be diffed.

// Generated by tools/gen_dump_kinds.py; do not edit by hand.
// Generated by tools/gen_dump_kinds.py; do not edit by hand.
fn dump_kname(k: T) -> str {
    if k == T::Int { return "int"; }
    if k == T::Float { return "float"; }
    if k == T::Str { return "str"; }
    if k == T::CStr { return "cstr"; }
    if k == T::Char { return "charlit"; }
    if k == T::Ident { return "ident"; }
    if k == T::KwFn { return "fn"; }
    if k == T::KwImport { return "import"; }
    if k == T::KwStatic { return "static"; }
    if k == T::KwConst { return "const"; }
    if k == T::KwEnum { return "enum"; }
    if k == T::KwStruct { return "struct"; }
    if k == T::KwUnion { return "union"; }
    if k == T::KwTypedef { return "typedef"; }
    if k == T::KwRepr { return "repr"; }
    if k == T::KwPacked { return "packed"; }
    if k == T::KwAlign { return "align"; }
    if k == T::KwExtern { return "extern"; }
    if k == T::KwPub { return "pub"; }
    if k == T::KwMod { return "mod"; }
    if k == T::KwModule { return "module"; }
    if k == T::KwMacro { return "macro"; }
    if k == T::KwSwitch { return "switch"; }
    if k == T::KwCase { return "case"; }
    if k == T::KwDefault { return "default"; }
    if k == T::KwFor { return "for"; }
    if k == T::KwDo { return "do"; }
    if k == T::KwGoto { return "goto"; }
    if k == T::KwNull { return "null"; }
    if k == T::KwVolatile { return "volatile"; }
    if k == T::KwSizeof { return "sizeof"; }
    if k == T::KwAlignof { return "alignof"; }
    if k == T::KwOffsetof { return "offsetof"; }
    if k == T::KwLet { return "let"; }
    if k == T::KwMut { return "mut"; }
    if k == T::KwIf { return "if"; }
    if k == T::KwElse { return "else"; }
    if k == T::KwWhile { return "while"; }
    if k == T::KwLoop { return "loop"; }
    if k == T::KwBreak { return "break"; }
    if k == T::KwContinue { return "continue"; }
    if k == T::KwReturn { return "return"; }
    if k == T::KwUnsafe { return "unsafe"; }
    if k == T::KwAs { return "as"; }
    if k == T::KwTrue { return "true"; }
    if k == T::KwFalse { return "false"; }
    if k == T::TyI8 { return "i8"; }
    if k == T::TyI16 { return "i16"; }
    if k == T::TyI32 { return "i32"; }
    if k == T::TyI64 { return "i64"; }
    if k == T::TyU8 { return "u8"; }
    if k == T::TyU16 { return "u16"; }
    if k == T::TyU32 { return "u32"; }
    if k == T::TyU64 { return "u64"; }
    if k == T::TyUsize { return "usize"; }
    if k == T::TyIsize { return "isize"; }
    if k == T::TyBool { return "bool"; }
    if k == T::TyChar { return "char"; }
    if k == T::TyF32 { return "f32"; }
    if k == T::TyF64 { return "f64"; }
    if k == T::TyStr { return "strtype"; }
    if k == T::TyCStr { return "cstrtype"; }
    if k == T::TyVec { return "vectype"; }
    if k == T::LParen { return "lparen"; }
    if k == T::RParen { return "rparen"; }
    if k == T::LBrace { return "lbrace"; }
    if k == T::RBrace { return "rbrace"; }
    if k == T::LBracket { return "lbracket"; }
    if k == T::RBracket { return "rbracket"; }
    if k == T::Comma { return "comma"; }
    if k == T::Semi { return "semi"; }
    if k == T::Colon { return "colon"; }
    if k == T::ColonColon { return "coloncolon"; }
    if k == T::Dot { return "dot"; }
    if k == T::DotDot { return "dotdot"; }
    if k == T::Ellipsis { return "dotdotdot"; }
    if k == T::Arrow { return "arrow"; }
    if k == T::Eq { return "assign"; }
    if k == T::PlusEq { return "pluseq"; }
    if k == T::MinusEq { return "minuseq"; }
    if k == T::StarEq { return "stareq"; }
    if k == T::SlashEq { return "slasheq"; }
    if k == T::PercentEq { return "percenteq"; }
    if k == T::AmpEq { return "ampeq"; }
    if k == T::PipeEq { return "pipeeq"; }
    if k == T::CaretEq { return "careteq"; }
    if k == T::ShlEq { return "shleq"; }
    if k == T::ShrEq { return "shreq"; }
    if k == T::EqEq { return "eqeq"; }
    if k == T::Ne { return "noteq"; }
    if k == T::Lt { return "lt"; }
    if k == T::Le { return "le"; }
    if k == T::Gt { return "gt"; }
    if k == T::Ge { return "ge"; }
    if k == T::Plus { return "plus"; }
    if k == T::Minus { return "minus"; }
    if k == T::Star { return "star"; }
    if k == T::Slash { return "slash"; }
    if k == T::Percent { return "percent"; }
    if k == T::Amp { return "amp"; }
    if k == T::AmpAmp { return "ampamp"; }
    if k == T::Pipe { return "pipe"; }
    if k == T::PipePipe { return "pipepipe"; }
    if k == T::Caret { return "caret"; }
    if k == T::Bang { return "not"; }
    if k == T::Shl { return "shl"; }
    if k == T::Shr { return "shr"; }
    if k == T::Tilde { return "tilde"; }
    if k == T::Question { return "question"; }
    if k == T::Hash { return "hash"; }
    if k == T::At { return "at"; }
    if k == T::Eof { return "eof"; }
    return "unknown";
}

fn dump_escape(out: *mut Buf, s: str) {
    let mut i: usize = 0;
    while i < len(s) {
        let c: u8 = s[i];
        if c == 10 {
            rt_s(out, "\\n");
        } else if c == 9 {
            rt_s(out, "\\t");
        } else if c == 13 {
            rt_s(out, "\\r");
        } else {
            rt_b(out, c);
        }
        i = i + 1;
    }
}

fn dump_tokens(a: *mut Arena, name: str, text: str) -> str {
    let mut d: Diags = diags_new();
    let mut srcs: SrcList = srcs_new();
    let mut out: Buf = rt_buf(a);
    let op: *mut Buf = &mut out;
    unsafe {
        let src: *mut Src = srcs_add(&mut srcs, a, name, text);
        let arr: TokArr = lx_run(a, src, &mut d);
        let mut i: i32 = 0;
        while i < arr.len as i32 {
            let t: *mut Tok = arr.data + i as usize;
            rt_s(op, dump_kname((*t).kind));
            rt_s(op, " ");
            rt_i(op, (*t).line as i64);
            rt_s(op, ":");
            rt_i(op, (*t).col as i64);
            rt_s(op, " ");
            let raw: str = rt_slice(text, (*t).start, (*t).start + (*t).len);
            dump_escape(op, raw);
            rt_b(op, 10);
            i = i + 1;
        }
    }
    return rt_view(op);
}

// --- AST shape -------------------------------------------------------------

const DK_STMT_LET: i32 = 0;
const DK_STMT_ASSIGN: i32 = 1;
const DK_STMT_COMPOUND: i32 = 2;
const DK_STMT_EXPR: i32 = 3;
const DK_STMT_IF: i32 = 4;
const DK_STMT_WHILE: i32 = 5;
const DK_STMT_LOOP: i32 = 6;
const DK_STMT_BREAK: i32 = 7;
const DK_STMT_CONTINUE: i32 = 8;
const DK_STMT_RETURN: i32 = 9;
const DK_STMT_UNSAFE: i32 = 10;
const DK_STMT_BLOCK: i32 = 11;
const DK_STMT_SWITCH: i32 = 12;
const DK_STMT_CASE: i32 = 13;
const DK_STMT_DEFAULT: i32 = 14;
const DK_STMT_EMPTY: i32 = 15;
const DK_EX_INT: i32 = 16;
const DK_EX_FLOAT: i32 = 17;
const DK_EX_STR: i32 = 18;
const DK_EX_CSTR: i32 = 19;
const DK_EX_CHAR: i32 = 20;
const DK_EX_BOOL: i32 = 21;
const DK_EX_NULL: i32 = 22;
const DK_EX_IDENT: i32 = 23;
const DK_EX_PATH: i32 = 24;
const DK_EX_CALL: i32 = 25;
const DK_EX_INDEX: i32 = 26;
const DK_EX_FIELD: i32 = 27;
const DK_EX_UNARY: i32 = 28;
const DK_EX_BINARY: i32 = 29;
const DK_EX_CAST: i32 = 30;
const DK_EX_SIZEOF: i32 = 31;
const DK_EX_ALIGNOF: i32 = 32;
const DK_EX_OFFSETOF: i32 = 33;
const DK_EX_STRUCTLIT: i32 = 34;
const DK_EX_ARRAYLIT: i32 = 35;
const DK_EX_SLICERANGE: i32 = 36;
const DK_COUNT: i32 = 37;

fn dump_cname(i: i32) -> str {
    if i == 0 { return "stmt.let"; }
    if i == 1 { return "stmt.assign"; }
    if i == 2 { return "stmt.compound_assign"; }
    if i == 3 { return "stmt.expr"; }
    if i == 4 { return "stmt.if"; }
    if i == 5 { return "stmt.while"; }
    if i == 6 { return "stmt.loop"; }
    if i == 7 { return "stmt.break"; }
    if i == 8 { return "stmt.continue"; }
    if i == 9 { return "stmt.return"; }
    if i == 10 { return "stmt.unsafe"; }
    if i == 11 { return "stmt.block"; }
    if i == 12 { return "stmt.switch"; }
    if i == 13 { return "stmt.case"; }
    if i == 14 { return "stmt.default"; }
    if i == 15 { return "stmt.empty"; }
    if i == 16 { return "expr.int"; }
    if i == 17 { return "expr.float"; }
    if i == 18 { return "expr.str"; }
    if i == 19 { return "expr.cstr"; }
    if i == 20 { return "expr.char"; }
    if i == 21 { return "expr.bool"; }
    if i == 22 { return "expr.null"; }
    if i == 23 { return "expr.ident"; }
    if i == 24 { return "expr.path"; }
    if i == 25 { return "expr.call"; }
    if i == 26 { return "expr.index"; }
    if i == 27 { return "expr.field"; }
    if i == 28 { return "expr.unary"; }
    if i == 29 { return "expr.binary"; }
    if i == 30 { return "expr.cast"; }
    if i == 31 { return "expr.sizeof"; }
    if i == 32 { return "expr.alignof"; }
    if i == 33 { return "expr.offsetof"; }
    if i == 34 { return "expr.structlit"; }
    if i == 35 { return "expr.arraylit"; }
    if i == 36 { return "expr.slicerange"; }
    return "?";
}

struct Dump {
    a: *mut Arena,
    counts: *mut i32,
}

fn dump_inc(d: *mut Dump, k: i32) {
    unsafe {
        *( (*d).counts + k as usize) = *( (*d).counts + k as usize) + 1;
    }
}

fn dump_expr(d: *mut Dump, e: *mut Expr) {
    unsafe {
        if e == null {
            return;
        }
        let k: E = (*e).kind;
        if k == E::IntLit { dump_inc(d, DK_EX_INT); return; }
        if k == E::FloatLit { dump_inc(d, DK_EX_FLOAT); return; }
        if k == E::StrLit { dump_inc(d, DK_EX_STR); return; }
        if k == E::CStrLit { dump_inc(d, DK_EX_CSTR); return; }
        if k == E::CharLit { dump_inc(d, DK_EX_CHAR); return; }
        if k == E::BoolLit { dump_inc(d, DK_EX_BOOL); return; }
        if k == E::NullLit { dump_inc(d, DK_EX_NULL); return; }
        if k == E::Ident { dump_inc(d, DK_EX_IDENT); return; }
        if k == E::Path { dump_inc(d, DK_EX_PATH); return; }
        if k == E::Sizeof { dump_inc(d, DK_EX_SIZEOF); return; }
        if k == E::Alignof { dump_inc(d, DK_EX_ALIGNOF); return; }
        if k == E::Offsetof { dump_inc(d, DK_EX_OFFSETOF); return; }
        if k == E::Field {
            dump_inc(d, DK_EX_FIELD);
            dump_expr(d, (*e).lhs);
            return;
        }
        if k == E::Unary {
            dump_inc(d, DK_EX_UNARY);
            dump_expr(d, (*e).lhs);
            return;
        }
        if k == E::Binary {
            dump_inc(d, DK_EX_BINARY);
            dump_expr(d, (*e).lhs);
            dump_expr(d, (*e).rhs);
            return;
        }
        if k == E::Cast {
            dump_inc(d, DK_EX_CAST);
            dump_expr(d, (*e).lhs);
            return;
        }
        if k == E::Call {
            dump_inc(d, DK_EX_CALL);
            dump_expr(d, (*e).lhs);
            let mut a: *mut Expr = (*e).args;
            while a != null {
                dump_expr(d, a);
                a = (*a).next;
            }
            return;
        }
        if k == E::Index {
            dump_inc(d, DK_EX_INDEX);
            dump_expr(d, (*e).lhs);
            dump_expr(d, (*e).rhs);
            return;
        }
        if k == E::SliceRange {
            dump_inc(d, DK_EX_SLICERANGE);
            dump_expr(d, (*e).lhs);
            dump_expr(d, (*e).rhs);
            dump_expr(d, (*e).args);
            return;
        }
        if k == E::StructLit {
            dump_inc(d, DK_EX_STRUCTLIT);
            let mut a2: *mut Expr = (*e).args;
            while a2 != null {
                dump_expr(d, a2);
                a2 = (*a2).next;
            }
            return;
        }
        if k == E::ArrayLit {
            dump_inc(d, DK_EX_ARRAYLIT);
            let mut a3: *mut Expr = (*e).args;
            while a3 != null {
                dump_expr(d, a3);
                a3 = (*a3).next;
            }
            return;
        }
    }
}

fn dump_stmt(d: *mut Dump, s: *mut Stmt) {
    unsafe {
        if s == null {
            return;
        }
        if (*s).kind == S::Let {
            dump_inc(d, DK_STMT_LET);
            dump_expr(d, (*s).expr);
        } else if (*s).kind == S::Assign {
            if (*s).op == T::Eq {
                dump_inc(d, DK_STMT_ASSIGN);
            } else {
                dump_inc(d, DK_STMT_COMPOUND);
            }
            dump_expr(d, (*s).expr);
            dump_expr(d, (*s).rhs);
        } else if (*s).kind == S::Expr {
            dump_inc(d, DK_STMT_EXPR);
            dump_expr(d, (*s).expr);
        } else if (*s).kind == S::If {
            dump_inc(d, DK_STMT_IF);
            dump_expr(d, (*s).expr);
            dump_stmts(d, (*s).body);
            dump_stmt(d, (*s).els);
        } else if (*s).kind == S::While {
            dump_inc(d, DK_STMT_WHILE);
            dump_expr(d, (*s).expr);
            dump_stmts(d, (*s).body);
        } else if (*s).kind == S::Loop {
            dump_inc(d, DK_STMT_LOOP);
            dump_stmts(d, (*s).body);
        } else if (*s).kind == S::Break {
            dump_inc(d, DK_STMT_BREAK);
        } else if (*s).kind == S::Continue {
            dump_inc(d, DK_STMT_CONTINUE);
        } else if (*s).kind == S::Return {
            dump_inc(d, DK_STMT_RETURN);
            dump_expr(d, (*s).expr);
        } else if (*s).kind == S::Unsafe {
            dump_inc(d, DK_STMT_UNSAFE);
            dump_stmts(d, (*s).body);
        } else if (*s).kind == S::Block {
            dump_inc(d, DK_STMT_BLOCK);
            dump_stmts(d, (*s).body);
        } else if (*s).kind == S::Switch {
            dump_inc(d, DK_STMT_SWITCH);
            dump_expr(d, (*s).expr);
            let mut c: *mut Case = (*s).cases;
            while c != null {
                if (*c).is_default {
                    dump_inc(d, DK_STMT_DEFAULT);
                } else {
                    dump_inc(d, DK_STMT_CASE);
                    dump_expr(d, (*c).expr);
                }
                dump_stmts(d, (*c).body);
                c = (*c).next;
            }
        } else if (*s).kind == S::Empty {
            dump_inc(d, DK_STMT_EMPTY);
        }
    }
}

fn dump_stmts(d: *mut Dump, first: *mut Stmt) {
    unsafe {
        let mut s: *mut Stmt = first;
        while s != null {
            dump_stmt(d, s);
            s = (*s).next;
        }
    }
}

fn dump_sig(a: *mut Arena, out: *mut Buf, dcl: *mut Decl) {
    unsafe {
        rt_s(out, "sig ");
        if (*dcl).is_extern {
            rt_s(out, "extern ");
        }
        rt_s(out, "fn ");
        rt_s(out, (*dcl).name);
        rt_s(out, "(");
        let mut p: *mut Param = (*dcl).params;
        let mut first: bool = true;
        while p != null {
            if !first {
                rt_s(out, ", ");
            }
            doc_type(out, (*p).ty);
            first = false;
            p = (*p).next;
        }
        rt_s(out, ")");
        if (*dcl).ty != null && (*(*dcl).ty).kind != K::Void {
            rt_s(out, " -> ");
            doc_type(out, (*dcl).ty);
        }
        rt_s(out, "\n");
    }
}

fn dump_item_kind(k: I) -> str {
    if k == I::Func { return "fn"; }
    if k == I::Struct { return "struct"; }
    if k == I::Enum { return "enum"; }
    if k == I::Const { return "const"; }
    if k == I::Static { return "static"; }
    if k == I::Typedef { return "typedef"; }
    return "import";
}

fn dump_ast(a: *mut Arena, prog: *mut Program) -> str {
    let mut ib: Buf = rt_buf(a);
    let ip: *mut Buf = &mut ib;
    let mut sb: Buf = rt_buf(a);
    let sp: *mut Buf = &mut sb;
    let counts: *mut i32 = rt_alloc(a, (DK_COUNT as usize) * sizeof(i32)) as *mut i32;
    rt_memzero(counts as *mut u8, (DK_COUNT as usize) * sizeof(i32));
    let mut dm: Dump = Dump { a: a, counts: counts };
    let dp: *mut Dump = &mut dm;
    unsafe {
        let mut it: *mut Item = (*prog).items;
        while it != null {
            let dcl: *mut Decl = (*it).decl;
            rt_s(ip, "item ");
            rt_s(ip, dump_item_kind((*it).kind));
            if dcl != null {
                rt_s(ip, " ");
                rt_s(ip, (*dcl).name);
            }
            rt_s(ip, "\n");
            if dcl != null && (*it).kind == I::Func {
                dump_sig(a, sp, dcl);
                dump_stmts(dp, (*dcl).body);
            } else if dcl != null && ((*it).kind == I::Const || (*it).kind == I::Static) {
                dump_expr(dp, (*dcl).init);
            } else if dcl != null && (*it).kind == I::Enum {
                let mut v: *mut Variant = (*dcl).variants;
                while v != null {
                    dump_expr(dp, (*v).expr);
                    v = (*v).next;
                }
            }
            it = (*it).next;
        }
    }
    let mut out: Buf = rt_buf(a);
    let op: *mut Buf = &mut out;
    rt_s(op, rt_view(ip));
    rt_s(op, rt_view(sp));
    unsafe {
        let mut i: i32 = 0;
        while i < DK_COUNT {
            rt_s(op, "count ");
            rt_s(op, dump_cname(i));
            rt_s(op, " ");
            rt_i(op, *(counts + i as usize) as i64);
            rt_s(op, "\n");
            i = i + 1;
        }
    }
    return rt_view(op);
}
