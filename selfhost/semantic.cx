// CoreX bootstrap semantic analysis: symbol collection, type resolution,
// struct layout, constant evaluation, type checking, mutability and unsafe
// gating, and return analysis. The AST is annotated in place; codegen consumes
// `expr.ty`, `expr.decl`, `expr.index`, `expr.opty`, and `stmt.decl`.

struct Sem {
    a: *mut Arena,
    d: *mut Diags,
    srcs: *mut SrcList,
    prog: *mut Program,
    globals: *mut Decl,
    gtail: *mut Decl,
    scope: *mut Scope,
    cur_fn: *mut Decl,
    unsafe_depth: i32,
    loop_depth: i32,
    switch_depth: i32,
    depth: i32,
    depth_reported: bool,
    slot: i32,
    errors: i32,
    labels: *mut Lbl,
    cur_module: str,
}

fn sdiag(s: *mut Sem, file: i32, line: i32, col: i32, msg: str) {
    unsafe {
    diag_add((*s).d, (*s).a, file, line, col, msg);
    (*s).errors = (*s).errors + 1;

    }
}

fn sdiagc(s: *mut Sem, code: str, file: i32, line: i32, col: i32, msg: str) {
    unsafe {
    diag_addc((*s).d, (*s).a, file, line, col, code, msg);
    (*s).errors = (*s).errors + 1;

    }
}

fn type_is_int(t: *mut Type) -> bool {
    unsafe {
    if t == null {
        return false;
    }
    let k: K = (*t).kind;
    return k == K::I8 || k == K::I16 || k == K::I32 || k == K::I64
        || k == K::U8 || k == K::U16 || k == K::U32 || k == K::U64
        || k == K::Usize || k == K::Isize || k == K::Char;

    }
}

fn type_is_signed(t: *mut Type) -> bool {
    unsafe {
    if t == null { return false; }
    let k: K = (*t).kind;
    return k == K::I8 || k == K::I16 || k == K::I32 || k == K::I64 || k == K::Isize;

    }
}

fn type_is_float(t: *mut Type) -> bool {
    unsafe {
    if t == null {
        return false;
    }
    return (*t).kind == K::F32 || (*t).kind == K::F64;

    }
}

// Integer types that participate in `as` conversions to and from floats.
// `char` and enums are distinct from `Int` in the reference type model, so
// char/enum <-> float casts stay rejected.
fn type_is_num(t: *mut Type) -> bool {
    unsafe {
    if t == null {
        return false;
    }
    let k: K = (*t).kind;
    return k == K::I8 || k == K::I16 || k == K::I32 || k == K::I64
        || k == K::U8 || k == K::U16 || k == K::U32 || k == K::U64
        || k == K::Usize || k == K::Isize;

    }
}

// Largest literal magnitude accepted for an integer type, mirroring the
// oracle's `IntTy::max_literal`. Non-int kinds (char) are unbounded here.
fn int_max_literal(k: K) -> u64 {
    if k == K::I8 { return 127; }
    if k == K::I16 { return 32767; }
    if k == K::I32 { return 2147483647; }
    if k == K::I64 || k == K::Isize { return 9223372036854775807; }
    if k == K::U8 { return 255; }
    if k == K::U16 { return 65535; }
    if k == K::U32 { return 4294967295; }
    return 18446744073709551615;
}

fn type_ok(s: *mut Sem, t: *mut Type) -> bool {
    unsafe {
    if t == null { return false; }
    let base: usize = (*(*s).a).base as usize;
    let cap: usize = (*(*s).a).cap;
    let p: usize = t as usize;
    if p < base || p + sizeof(Type) > base + cap { return false; }
    let k: i32 = (*t).kind as i32;
    return k >= 0 && k <= 24;

    }
}

fn type_is_ptr(t: *mut Type) -> bool {
    unsafe {
    if t == null { return false; }
    return (*t).kind == K::Ptr || (*t).kind == K::CStr;

    }
}

// Types whose LLVM representation is a single `ptr`: used for `null`
// inference and `==`/`!=` on pointers and function pointers.
fn type_is_ptr_like(t: *mut Type) -> bool {
    unsafe {
    if t == null { return false; }
    let k: K = (*t).kind;
    return k == K::Ptr || k == K::CStr || k == K::Fn;

    }
}

fn type_is_aggregate(t: *mut Type) -> bool {
    unsafe {
    if t == null { return false; }
    let k: K = (*t).kind;
    return k == K::Str || k == K::Slice || k == K::Array || k == K::Struct || k == K::Vec;

    }
}

fn type_eq(a: *mut Type, b: *mut Type) -> bool {
    unsafe {
    if a == null || b == null {
        return a == b;
    }
    if (*a).kind != (*b).kind {
        return false;
    }
    let k: K = (*a).kind;
    if k == K::Ptr {
        return type_eq((*a).elem, (*b).elem);
    }
    if k == K::Array {
        return (*a).len == (*b).len && type_eq((*a).elem, (*b).elem);
    }
    if k == K::Slice || k == K::Vec {
        return type_eq((*a).elem, (*b).elem);
    }
    if k == K::Struct || k == K::Enum {
        return (*a).decl == (*b).decl;
    }
    if k == K::Fn {
        if (*a).variadic && !(*b).variadic {
            return false;
        }
        if !(*a).variadic && (*b).variadic {
            return false;
        }
        if !type_eq((*a).ret, (*b).ret) {
            return false;
        }
        let mut pa: *mut Type = (*a).params;
        let mut pb: *mut Type = (*b).params;
        while pa != null && pb != null {
            if !type_eq(pa, pb) {
                return false;
            }
            pa = (*pa).next;
            pb = (*pb).next;
        }
        return pa == null && pb == null;
    }
    return true;

    }
}

fn type_compat(expected: *mut Type, actual: *mut Type) -> bool {
    unsafe {
    if expected == null || actual == null {
        return expected == actual;
    }
    if type_eq(expected, actual) {
        return true;
    }
    if (*expected).kind == K::Ptr && (*actual).kind == K::Ptr {
        if !(*expected).mutable && type_eq((*expected).elem, (*actual).elem) {
            return true;
        }
    }
    if (*expected).kind == K::Str && (*actual).kind == K::Slice {
        return (*actual).elem != null && (*((*actual).elem)).kind == K::U8;
    }
    if (*expected).kind == K::Slice && (*actual).kind == K::Str {
        return (*expected).elem != null && (*((*expected).elem)).kind == K::U8;
    }
    return false;

    }
}

fn align_to(v: usize, a: usize) -> usize {
    unsafe {
    if a <= 1 {
        return v;
    }
    return (v + a - 1) & (0 - a);

    }
}

fn sem_find(s: *mut Sem, name: str) -> *mut Decl {
    unsafe {
    let mut d: *mut Decl = (*s).globals;
    while d != null {
        if rt_eq((*d).name, name) {
            return d;
        }
        d = (*d).next;
    }
    return null;

    }
}

fn sem_add_global(s: *mut Sem, d: *mut Decl) {
    unsafe {
    // A builtin name cannot be declared as a root-level function: it would
    // never be reachable. Mangled module items are unaffected.
    if (*d).kind == D::Func && !has_dollar((*d).name) && builtin_id((*d).name) != 0 {
        sdiagc(s, "E0202", (*d).file, (*d).line, (*d).col, "reserved builtin name");
        return;
    }
    let old: *mut Decl = sem_find(s, (*d).name);
    if old != null {
        sdiagc(s, "E0202", (*d).file, (*d).line, (*d).col, "duplicate declaration");
        return;
    }
    if (*s).gtail == null {
        (*s).globals = d;
    } else {
        (*(*s).gtail).next = d;
    }
    (*s).gtail = d;

    }
}

fn scope_push(s: *mut Sem) {
    unsafe {
    let sc: *mut Scope = rt_alloc((*s).a, sizeof(Scope)) as *mut Scope;
    (*sc).parent = (*s).scope;
    (*sc).vars = null;
    (*s).scope = sc;

    }
}

fn scope_pop(s: *mut Sem) {
    unsafe {
    (*s).scope = (*(*s).scope).parent;

    }
}

fn scope_add(s: *mut Sem, d: *mut Decl) {
    unsafe {
    if rt_eq((*d).name, "_") {
        return;
    }
    (*d).next_local = (*(*s).scope).vars;
    (*(*s).scope).vars = d;

    }
}

// True when the innermost scope already declares `name`. Shadowing in a
// nested scope stays legal; a second binding in the same scope is E0202.
fn scope_has_current(s: *mut Sem, name: str) -> bool {
    unsafe {
    if (*s).scope == null {
        return false;
    }
    let mut d: *mut Decl = (*(*s).scope).vars;
    while d != null {
        if rt_eq((*d).name, name) {
            return true;
        }
        d = (*d).next_local;
    }
    return false;

    }
}

fn label_find(s: *mut Sem, name: str) -> *mut Lbl {
    unsafe {
    let mut l: *mut Lbl = (*s).labels;
    while l != null {
        if rt_eq((*l).name, name) {
            return l;
        }
        l = (*l).next;
    }
    return null;

    }
}

// Diagnostic with a quoted name: "<msg> `name`<suffix>".
fn sdiag_name(s: *mut Sem, file: i32, line: i32, col: i32, msg: str, name: str, suffix: str) {
    unsafe {
    let mut b: Buf = rt_buf((*s).a);
    let bp: *mut Buf = &mut b;
    rt_s(bp, msg);
    rt_s(bp, " `");
    rt_s(bp, name);
    rt_s(bp, "`");
    rt_s(bp, suffix);
    sdiag(s, file, line, col, rt_view(bp));

    }
}

fn sdiagc_name(s: *mut Sem, code: str, file: i32, line: i32, col: i32,
               msg: str, name: str, suffix: str) {
    unsafe {
    let mut b: Buf = rt_buf((*s).a);
    let bp: *mut Buf = &mut b;
    rt_s(bp, msg);
    rt_s(bp, " `");
    rt_s(bp, name);
    rt_s(bp, "`");
    rt_s(bp, suffix);
    sdiagc(s, code, file, line, col, rt_view(bp));

    }
}

fn collect_labels(s: *mut Sem, head: *mut Stmt) {
    unsafe {
    let mut p: *mut Stmt = head;
    while p != null {
        collect_label_stmt(s, p);
        p = (*p).next;
    }

    }
}

fn collect_label_stmt(s: *mut Sem, st: *mut Stmt) {
    unsafe {
    let k: S = (*st).kind;
    if k == S::Label {
        if label_find(s, (*st).name) != null {
            sdiagc_name(s, "E0202", (*st).file, (*st).line, (*st).col, "duplicate label", (*st).name, "");
        } else {
            let l: *mut Lbl = rt_alloc((*s).a, sizeof(Lbl)) as *mut Lbl;
            (*l).next = (*s).labels;
            (*l).name = (*st).name;
            (*l).id = -1;
            (*s).labels = l;
        }
        collect_label_stmt(s, (*st).body);
        return;
    }
    if k == S::If {
        collect_labels(s, (*st).body);
        if (*st).els != null {
            collect_label_stmt(s, (*st).els);
        }
        return;
    }
    if k == S::While || k == S::Loop || k == S::For || k == S::DoWhile
        || k == S::Unsafe || k == S::Block {
        collect_labels(s, (*st).body);
        return;
    }
    if k == S::Switch {
        let mut c: *mut Case = (*st).cases;
        while c != null {
            collect_labels(s, (*c).body);
            c = (*c).next;
        }
        return;
    }

    }
}

fn lookup_raw(s: *mut Sem, name: str) -> *mut Decl {
    unsafe {
    let mut sc: *mut Scope = (*s).scope;
    while sc != null {
        let mut d: *mut Decl = (*sc).vars;
        while d != null {
            if rt_eq((*d).name, name) {
                return d;
            }
            d = (*d).next_local;
        }
        sc = (*sc).parent;
    }
    return sem_find(s, name);

    }
}

// Unqualified names inside a module unit resolve against the unit's mangled
// names first, then against the flat namespace.
fn lookup(s: *mut Sem, name: str) -> *mut Decl {
    unsafe {
    // Locals and parameters shadow module items and root functions.
    if !has_dollar(name) {
        let local: *mut Decl = lookup_local(s, name);
        if local != null {
            return local;
        }
    }
    if !rt_eq((*s).cur_module, "") && !has_dollar(name) {
        let mut b: Buf = rt_buf((*s).a);
        let bp: *mut Buf = &mut b;
        rt_s(bp, (*s).cur_module);
        rt_s(bp, "$");
        rt_s(bp, name);
        let d: *mut Decl = lookup_raw(s, rt_view(bp));
        if d != null {
            return d;
        }
    }
    return lookup_raw(s, name);

    }
}

// Items of another unit are reachable only when declared `pub`.
fn visible(s: *mut Sem, d: *mut Decl) -> bool {
    unsafe {
    if d == null {
        return true;
    }
    if rt_eq((*d).unit, "") {
        return true;
    }
    if rt_eq((*d).unit, (*s).cur_module) {
        return true;
    }
    return (*d).is_pub;

    }
}

fn decl_value_type(s: *mut Sem, e: *mut Expr, d: *mut Decl) -> *mut Type {
    unsafe {
    (*e).decl = d;
    if (*d).kind == D::Global && (*d).is_volatile {
        (*e).is_volatile = true;
    }
    if !visible(s, d) {
        sdiag(s, (*e).file, (*e).line, (*e).col, "item is private to its module");
    }
    if (*d).kind == D::Func {
        let ft: *mut Type = decl_fn_type(s, d);
        (*e).ty = ft;
        return ft;
    }
    (*e).ty = (*d).ty;
    return (*d).ty;

    }
}

fn lookup_local(s: *mut Sem, name: str) -> *mut Decl {
    unsafe {
    let mut sc: *mut Scope = (*s).scope;
    while sc != null {
        let mut d: *mut Decl = (*sc).vars;
        while d != null {
            if rt_eq((*d).name, name) {
                return d;
            }
            d = (*d).next_local;
        }
        sc = (*sc).parent;
    }
    return null;

    }
}

// Copy a type node so parameter lists can chain it through `next` without
// aliasing the declaration's own nodes.
fn type_copy(s: *mut Sem, src: *mut Type) -> *mut Type {
    unsafe {
    let t: *mut Type = type_new((*s).a, K::Void);
    (*t).kind = (*src).kind;
    (*t).elem = (*src).elem;
    (*t).len = (*src).len;
    (*t).len_expr = (*src).len_expr;
    (*t).decl = (*src).decl;
    (*t).mutable = (*src).mutable;
    (*t).name = (*src).name;
    (*t).params = (*src).params;
    (*t).ret = (*src).ret;
    (*t).variadic = (*src).variadic;
    return t;

    }
}

// The `fn(T) -> R` type of a declared function, used when the function is
// named as a value rather than called directly.
fn decl_fn_type(s: *mut Sem, d: *mut Decl) -> *mut Type {
    unsafe {
    let mut head: *mut Type = null;
    let mut tail: *mut Type = null;
    let mut p: *mut Param = (*d).params;
    while p != null {
        let pt: *mut Type = type_copy(s, resolve_type(s, (*p).ty));
        if tail == null {
            head = pt;
        } else {
            (*tail).next = pt;
        }
        tail = pt;
        p = (*p).next;
    }
    return type_fn((*s).a, head, resolve_type(s, (*d).ty), (*d).variadic);

    }
}

fn find_field(d: *mut Decl, name: str) -> *mut Field {
    unsafe {
    let mut f: *mut Field = (*d).fields;
    while f != null {
        if rt_eq((*f).name, name) {
            return f;
        }
        f = (*f).next;
    }
    return null;

    }
}

fn find_variant(d: *mut Decl, name: str) -> *mut Variant {
    unsafe {
    let mut v: *mut Variant = (*d).variants;
    while v != null {
        if rt_eq((*v).name, name) {
            return v;
        }
        v = (*v).next;
    }
    return null;

    }
}

fn type_size(s: *mut Sem, t: *mut Type) -> usize {
    unsafe {
    if t == null {
        return 8;
    }
    let k: K = (*t).kind;
    if k == K::Void {
        return 0;
    }
    if k == K::Bool || k == K::I8 || k == K::U8 || k == K::Char {
        return 1;
    }
    if k == K::I16 || k == K::U16 {
        return 2;
    }
    if k == K::I32 || k == K::U32 || k == K::F32 || k == K::Enum {
        return 4;
    }
    if k == K::I64 || k == K::U64 || k == K::Usize || k == K::Isize || k == K::F64 || k == K::Ptr || k == K::CStr || k == K::Fn {
        return 8;
    }
    if k == K::Str || k == K::Slice {
        return 16;
    }
    if k == K::Vec {
        return 24;
    }
    if k == K::Array {
        return (*t).len * type_size(s, (*t).elem);
    }
    if k == K::Struct {
        if (*t).decl != null {
            if (*((*t).decl)).size == 0 && (*(*t).decl).nfields > 0 {
                layout_struct(s, (*t).decl);
            }
            return (*((*t).decl)).size;
        }
        return 0;
    }
    return 8;

    }
}

fn type_align(s: *mut Sem, t: *mut Type) -> usize {
    unsafe {
    if t == null {
        return 8;
    }
    let k: K = (*t).kind;
    if k == K::Void || k == K::Bool || k == K::I8 || k == K::U8 || k == K::Char {
        return 1;
    }
    if k == K::I16 || k == K::U16 {
        return 2;
    }
    if k == K::I32 || k == K::U32 || k == K::F32 || k == K::Enum {
        return 4;
    }
    if k == K::I64 || k == K::U64 || k == K::Usize || k == K::Isize || k == K::F64 || k == K::Ptr || k == K::CStr || k == K::Fn {
        return 8;
    }
    if k == K::Str || k == K::Slice || k == K::Vec {
        return 8;
    }
    if k == K::Array {
        return type_align(s, (*t).elem);
    }
    if k == K::Struct {
        if (*t).decl != null {
            if (*((*t).decl)).size == 0 && (*(*t).decl).nfields > 0 {
                layout_struct(s, (*t).decl);
            }
            return (*((*t).decl)).alignment;
        }
        return 1;
    }
    return 8;

    }
}

fn type_bits(t: *mut Type) -> i32 {
    unsafe {
    if t == null {
        return 0;
    }
    let k: K = (*t).kind;
    if k == K::I8 || k == K::U8 {
        return 8;
    }
    if k == K::I16 || k == K::U16 {
        return 16;
    }
    if k == K::I32 || k == K::U32 || k == K::Enum {
        return 32;
    }
    if k == K::I64 || k == K::U64 || k == K::Usize || k == K::Isize {
        return 64;
    }
    return 0;

    }
}

fn field_duplicate(d: *mut Decl, target: *mut Field) -> bool {
    unsafe {
    let mut q: *mut Field = (*d).fields;
    while q != null && q != target {
        if rt_eq((*q).name, (*target).name) {
            return true;
        }
        q = (*q).next;
    }
    return false;

    }
}

fn layout_struct(s: *mut Sem, d: *mut Decl) {
    unsafe {
    if (*d).laid_out {
        return;
    }
    if (*d).busy {
        sdiagc(s, "E0224", (*d).file, (*d).line, (*d).col, "type contains itself by value; use a pointer");
        (*d).size = 8;
        (*d).alignment = 8;
        (*d).laid_out = true;
        return;
    }
    (*d).busy = true;
    if (*d).is_union {
        let mut size: usize = 0;
        let mut al: usize = 1;
        let mut f: *mut Field = (*d).fields;
        if f == null {
            sdiag(s, (*d).file, (*d).line, (*d).col, "unions must have at least one field");
        }
        while f != null {
            if field_duplicate(d, f) {
                sdiagc(s, "E0228", (*d).file, (*d).line, (*d).col, "duplicate field name");
            }
            let ft: *mut Type = resolve_type(s, (*f).ty);
            if (*ft).kind == K::Array && (*ft).len == 0 {
                sdiagc(s, "E0224", (*d).file, (*d).line, (*d).col, "flexible array members are not allowed in unions");
            }
            let fa: usize = type_align(s, ft);
            let fs: usize = type_size(s, ft);
            (*f).offset = 0;
            (*f).size = fs;
            (*f).alignment = fa;
            (*f).bit_offset = 0;
            if fs > size {
                size = fs;
            }
            if fa > al {
                al = fa;
            }
            f = (*f).next;
        }
        if (*d).explicit_align > al {
            al = (*d).explicit_align;
        }
        (*d).alignment = al;
        (*d).size = align_to(size, al);
        (*d).busy = false;
        (*d).laid_out = true;
        return;
    }
    let mut off: usize = 0;
    let mut al: usize = 1;
    let mut unit_off: usize = 0;
    let mut unit_bits: i32 = 0;
    let mut unit_used: i32 = 0;
    let mut f: *mut Field = (*d).fields;
    if f == null {
        sdiag(s, (*d).file, (*d).line, (*d).col, "structs must have at least one field");
    }
    while f != null {
        if field_duplicate(d, f) {
            sdiagc(s, "E0228", (*d).file, (*d).line, (*d).col, "duplicate field name");
        }
        let ft: *mut Type = resolve_type(s, (*f).ty);
        if (*ft).kind == K::Array && (*ft).len == 0 {
            if (*f).next != null {
                sdiagc(s, "E0224", (*d).file, (*d).line, (*d).col, "flexible array member must be the last field");
            }
        }
        let fa: usize = type_align(s, ft);
        let fs: usize = type_size(s, ft);
        if (*f).bit_width > 0 {
            let bits: i32 = type_bits(ft);
            if bits == 0 {
                sdiagc(s, "E0216", (*d).file, (*d).line, (*d).col, "bitfield requires an integer or enum type");
                (*f).bit_width = 0;
            } else if (*f).bit_width > bits {
                sdiagc(s, "E0215", (*d).file, (*d).line, (*d).col, "bitfield width exceeds the width of its type");
                (*f).bit_width = bits;
            }
        }
        if (*f).bit_width > 0 {
            let bits: i32 = type_bits(ft);
            let mut fits: bool = false;
            if unit_bits == bits && unit_used + (*f).bit_width <= bits {
                fits = true;
            }
            if fits {
                (*f).offset = unit_off;
                (*f).bit_offset = unit_used;
                unit_used = unit_used + (*f).bit_width;
            } else {
                if !(*d).is_packed {
                    off = align_to(off, fa);
                }
                (*f).offset = off;
                (*f).bit_offset = 0;
                off = off + fs;
                unit_off = (*f).offset;
                unit_bits = bits;
                unit_used = (*f).bit_width;
            }
            (*f).size = fs;
            (*f).alignment = fa;
            if !(*d).is_packed && fa > al {
                al = fa;
            }
        } else {
            unit_bits = 0;
            if !(*d).is_packed {
                off = align_to(off, fa);
            }
            (*f).offset = off;
            (*f).bit_offset = 0;
            off = off + fs;
            (*f).size = fs;
            (*f).alignment = fa;
            if !(*d).is_packed && fa > al {
                al = fa;
            }
        }
        f = (*f).next;
    }
    if (*d).explicit_align > al {
        al = (*d).explicit_align;
    }
    (*d).alignment = al;
    (*d).size = align_to(off, al);
    (*d).busy = false;
    (*d).laid_out = true;

    }
}

fn resolve_type(s: *mut Sem, t: *mut Type) -> *mut Type {
    unsafe {
    if t == null {
        return null;
    }
    let k: K = (*t).kind;
    if k == K::Named {
        let d: *mut Decl = lookup(s, (*t).name);
        if d == null {
            sdiag(s, 0, 0, 0, "unknown type");
            (*t).kind = K::I32;
            return t;
        }
        if (*d).kind == D::Struct {
            if !visible(s, d) {
                sdiag(s, 0, 0, 0, "type is private to its module");
            }
            (*t).kind = K::Struct;
            (*t).decl = d;
            return t;
        }
        if (*d).kind == D::Enum {
            if !visible(s, d) {
                sdiag(s, 0, 0, 0, "type is private to its module");
            }
            (*t).kind = K::Enum;
            (*t).decl = d;
            return t;
        }
        if (*d).kind == D::Typedef {
            let target: *mut Type = resolve_type(s, (*d).ty);
            (*t).kind = (*target).kind;
            (*t).elem = (*target).elem;
            (*t).len = (*target).len;
            (*t).len_expr = (*target).len_expr;
            (*t).decl = (*target).decl;
            (*t).mutable = (*target).mutable;
            (*t).name = (*target).name;
            (*t).params = (*target).params;
            (*t).ret = (*target).ret;
            (*t).variadic = (*target).variadic;
            return t;
        }
        sdiag(s, 0, 0, 0, "type name does not denote a type");
        (*t).kind = K::I32;
        return t;
    }
    if k == K::Fn {
        let mut p: *mut Type = (*t).params;
        while p != null {
            let r: *mut Type = resolve_type(s, p);
            // Resolving a Named parameter rewrites it in place, but resolving
            // an alias returns its target; copy the resolved fields back.
            (*p).kind = (*r).kind;
            (*p).elem = (*r).elem;
            (*p).len = (*r).len;
            (*p).decl = (*r).decl;
            (*p).mutable = (*r).mutable;
            (*p).params = (*r).params;
            (*p).ret = (*r).ret;
            (*p).variadic = (*r).variadic;
            p = (*p).next;
        }
        (*t).ret = resolve_type(s, (*t).ret);
        return t;
    }
    if k == K::Ptr || k == K::Slice || k == K::Array || k == K::Vec {
        (*t).elem = resolve_type(s, (*t).elem);
        if k == K::Array && (*t).len_expr != null {
            if !int_const_foldable(s, (*t).len_expr) {
                sdiagc(s, "E0100", (*((*t).len_expr)).file, (*((*t).len_expr)).line, (*((*t).len_expr)).col,
                    "array length must be a constant integer expression (literal or previously declared `const`)");
                (*t).len = 1;
                (*t).len_expr = null;
                return t;
            }
            (*t).len = eval_int(s, (*t).len_expr) as usize;
            (*t).len_expr = null;
        }
        return t;
    }
    return t;

    }
}

// True when `e` is a constant integer expression the array-length rule
// accepts: a literal, `sizeof`/`alignof`/`offsetof`, a previously declared
// `const`/global/enum, or unary/binary/cast combinations of those. The oracle
// decides this in the parser; the bootstrap parser records the expression and
// resolves it here, so the same E0100 is raised at the same place.
fn int_const_foldable(s: *mut Sem, e: *mut Expr) -> bool {
    unsafe {
    if e == null {
        return false;
    }
    let k: E = (*e).kind;
    if k == E::IntLit || k == E::Sizeof || k == E::Alignof || k == E::Offsetof {
        return true;
    }
    if k == E::Ident {
        let d: *mut Decl = lookup(s, (*e).name);
        if d == null {
            return false;
        }
        return (*d).kind == D::Const || (*d).kind == D::Global || (*d).kind == D::Enum;
    }
    if k == E::Path {
        let mut b: Buf = rt_buf((*s).a);
        let bp: *mut Buf = &mut b;
        rt_s(bp, (*e).name);
        rt_s(bp, "$");
        rt_s(bp, (*e).field);
        let qname: str = rt_view(bp);
        if !rt_eq((*e).text, "") {
            let d: *mut Decl = sem_find(s, qname);
            return d != null && (*d).kind == D::Enum;
        }
        let item: *mut Decl = sem_find(s, qname);
        if item != null && (*item).kind != D::Enum {
            return (*item).kind == D::Const && (*item).cval_kind == 1;
        }
        let d: *mut Decl = lookup(s, (*e).name);
        return d != null && (*d).kind == D::Enum;
    }
    if k == E::Unary {
        if (*e).op == T::Minus || (*e).op == T::Bang {
            return int_const_foldable(s, (*e).lhs);
        }
        return false;
    }
    if k == E::Cast {
        return int_const_foldable(s, (*e).lhs);
    }
    if k == E::Binary {
        return int_const_foldable(s, (*e).lhs) && int_const_foldable(s, (*e).rhs);
    }
    return false;

    }
}

fn eval_str(s: *mut Sem, e: *mut Expr) -> str {
    unsafe {
    if e == null {
        return "";
    }
    if (*e).kind == E::StrLit {
        return (*e).text;
    }
    if (*e).kind == E::Ident {
        let d: *mut Decl = lookup(s, (*e).name);
        if d != null && (*d).kind == D::Const && (*d).cval_kind == 2 {
            return (*d).cval_s;
        }
    }
    return "";

    }
}

fn eval_int(s: *mut Sem, e: *mut Expr) -> i64 {
    unsafe {
    if e == null {
        return 0;
    }
    let k: E = (*e).kind;
    if k == E::IntLit || k == E::CharLit || k == E::BoolLit {
        return (*e).ival;
    }
    if k == E::NullLit {
        return 0;
    }
    if k == E::Ident {
        let d: *mut Decl = lookup(s, (*e).name);
        if d != null && (*d).kind == D::Const && (*d).cval_kind == 1 {
            return (*d).cval;
        }
        if d != null && (*d).kind == D::Enum {
            return 0;
        }
        return 0;
    }
    if k == E::Path {
        // Mirrors check_expr: `module::ITEM` is a mangled item; `Enum::Variant`
        // (optionally `module::Enum::Variant`) names an enum variant.
        let mut b: Buf = rt_buf((*s).a);
        let bp: *mut Buf = &mut b;
        rt_s(bp, (*e).name);
        rt_s(bp, "$");
        rt_s(bp, (*e).field);
        let qname: str = rt_view(bp);
        if !rt_eq((*e).text, "") {
            let d: *mut Decl = sem_find(s, qname);
            if d != null && (*d).kind == D::Enum {
                let v: *mut Variant = find_variant(d, (*e).text);
                if v != null {
                    return (*v).value;
                }
            }
            return 0;
        }
        let item: *mut Decl = sem_find(s, qname);
        if item != null && (*item).kind != D::Enum {
            if (*item).kind == D::Const && (*item).cval_kind == 1 {
                return (*item).cval;
            }
            return 0;
        }
        let d: *mut Decl = lookup(s, (*e).name);
        if d != null && (*d).kind == D::Enum {
            let v: *mut Variant = find_variant(d, (*e).field);
            if v != null {
                return (*v).value;
            }
        }
        return 0;
    }
    if k == E::Sizeof {
        let t: *mut Type = resolve_type(s, (*e).type_arg);
        return type_size(s, t) as i64;
    }
    if k == E::Alignof {
        let t: *mut Type = resolve_type(s, (*e).type_arg);
        return type_align(s, t) as i64;
    }
    if k == E::Offsetof {
        let t: *mut Type = resolve_type(s, (*e).type_arg);
        if (*t).kind == K::Struct && (*t).decl != null {
            let f: *mut Field = find_field((*t).decl, (*e).field);
            if f != null {
                if (*f).bit_width > 0 {
                    sdiagc(s, "E0203", (*e).file, (*e).line, (*e).col, "offsetof cannot be applied to a bitfield");
                    return 0;
                }
                return (*f).offset as i64;
            }
        }
        return 0;
    }
    if k == E::Cast {
        return eval_int(s, (*e).lhs);
    }
    if k == E::Unary {
        let v: i64 = eval_int(s, (*e).lhs);
        if (*e).op == T::Minus {
            return 0 - v;
        }
        if (*e).op == T::Bang {
            if v == 0 { return 1; }
            return 0;
        }
        return v;
    }
    if k == E::Binary {
        let a: i64 = eval_int(s, (*e).lhs);
        let b: i64 = eval_int(s, (*e).rhs);
        let op: T = (*e).op;
        if op == T::Plus { return a + b; }
        if op == T::Minus { return a - b; }
        if op == T::Star { return a * b; }
        if op == T::Slash { if b == 0 { return 0; } return a / b; }
        if op == T::Percent { if b == 0 { return 0; } return a % b; }
        if op == T::Amp { return a & b; }
        if op == T::Pipe { return a | b; }
        if op == T::Caret { return a ^ b; }
        if op == T::Shl { return a << b; }
        if op == T::Shr { return a >> b; }
        if op == T::EqEq { if a == b { return 1; } return 0; }
        if op == T::Ne { if a != b { return 1; } return 0; }
        if op == T::Lt { if a < b { return 1; } return 0; }
        if op == T::Le { if a <= b { return 1; } return 0; }
        if op == T::Gt { if a > b { return 1; } return 0; }
        if op == T::Ge { if a >= b { return 1; } return 0; }
        if op == T::AmpAmp { if a != 0 && b != 0 { return 1; } return 0; }
        if op == T::PipePipe { if a != 0 || b != 0 { return 1; } return 0; }
    }
    return 0;

    }
}

// Fold `+ - * /` on two binary64 bit patterns with host IEEE-754 arithmetic.
// The compiler runs on the same machine as the oracle, so evaluating with its
// own `f64` matches the oracle's const evaluator; `float_ll` narrows when the
// destination global is `f32`.
fn float_bin_bits(op: T, a: i64, b: i64) -> i64 {
    unsafe {
    let mut x: f64 = 0.0;
    let mut y: f64 = 0.0;
    let px: *mut u64 = (&mut x) as *mut u64;
    let py: *mut u64 = (&mut y) as *mut u64;
    *px = a as u64;
    *py = b as u64;
    let mut z: f64 = x;
    if op == T::Plus { z = x + y; }
    else if op == T::Minus { z = x - y; }
    else if op == T::Star { z = x * y; }
    else if op == T::Slash { z = x / y; }
    let pz: *mut i64 = (&mut z) as *mut i64;
    return *pz;

    }
}

// Evaluate a constant float expression to binary64 bits. Literals, unary
// minus, float-typed constant references, float casts, and `+ - * /` on those
// are folded; anything else is reported instead of silently producing a wrong
// constant.
fn eval_float_bits(s: *mut Sem, e: *mut Expr) -> i64 {
    unsafe {
    if e == null {
        return 0;
    }
    let k: E = (*e).kind;
    if k == E::FloatLit {
        return (*e).ival;
    }
    if k == E::Ident {
        let d: *mut Decl = lookup(s, (*e).name);
        if d != null && (*d).kind == D::Const && (*d).cval_kind == 3 {
            return (*d).cval;
        }
        sdiag(s, (*e).file, (*e).line, (*e).col, "float constant initializer must be a literal");
        return 0;
    }
    if k == E::Unary && (*e).op == T::Minus {
        let bits: i64 = eval_float_bits(s, (*e).lhs);
        let one: i64 = 1;
        let sign: i64 = one << 63;
        return bits ^ sign;
    }
    if k == E::Cast {
        let to: *mut Type = (*e).ty;
        let bits2: i64 = eval_float_bits(s, (*e).lhs);
        if to != null && (*to).kind == K::F32 {
            return rt_f32_as_f64(rt_f64_as_f32(bits2));
        }
        if to != null && (*to).kind == K::F64 {
            return bits2;
        }
    }
    if k == E::Binary {
        let op: T = (*e).op;
        if op == T::Plus || op == T::Minus || op == T::Star || op == T::Slash {
            let a: i64 = eval_float_bits(s, (*e).lhs);
            let b: i64 = eval_float_bits(s, (*e).rhs);
            return float_bin_bits(op, a, b);
        }
    }
    sdiag(s, (*e).file, (*e).line, (*e).col, "float constant initializer must be a literal");
    return 0;

    }
}

// True when `cand` is declared before `cur` in the global list. A static
// initializer may only copy globals that are already initialized, which also
// rules out self-reference and cycles.
fn global_before(s: *mut Sem, cand: *mut Decl, cur: *mut Decl) -> bool {
    unsafe {
    let mut d: *mut Decl = (*s).globals;
    while d != null {
        if d == cur {
            return false;
        }
        if d == cand {
            return true;
        }
        d = (*d).next;
    }
    return false;

    }
}

// Constant expressions accepted in global initializers: literals, enum
// variants, previously declared globals and constants, `sizeof`/`alignof`/
// `offsetof`, `&global`, unary/binary arithmetic, casts, and aggregate
// literals built from those. Nothing here runs at load time.
fn is_const_expr(s: *mut Sem, e: *mut Expr, cur: *mut Decl) -> bool {
    unsafe {
    if e == null {
        return true;
    }
    let k: E = (*e).kind;
    if k == E::IntLit || k == E::FloatLit || k == E::StrLit || k == E::CharLit
        || k == E::BoolLit || k == E::NullLit || k == E::Path
        || k == E::Sizeof || k == E::Alignof || k == E::Offsetof {
        return true;
    }
    if k == E::Ident {
        if (*e).decl == null {
            return false;
        }
        let d: *mut Decl = (*e).decl;
        if (*d).kind == D::Const {
            return true;
        }
        if (*d).kind == D::Global {
            return global_before(s, d, cur);
        }
        return false;
    }
    if k == E::Unary {
        if (*e).op == T::Amp {
            if (*e).lhs != null && (*(*e).lhs).kind == E::Ident
                && (*(*e).lhs).decl != null
                && ((*(*(*e).lhs).decl).kind == D::Global || (*(*(*e).lhs).decl).kind == D::Func) {
                return true;
            }
            return false;
        }
        return is_const_expr(s, (*e).lhs, cur);
    }
    if k == E::Binary {
        return is_const_expr(s, (*e).lhs, cur) && is_const_expr(s, (*e).rhs, cur);
    }
    if k == E::Cast {
        return is_const_expr(s, (*e).lhs, cur);
    }
    if k == E::StructLit || k == E::ArrayLit || k == E::CompoundLit {
        let mut a: *mut Expr = (*e).args;
        while a != null {
            if !is_const_expr(s, a, cur) {
                return false;
            }
            a = (*a).next;
        }
        if k == E::ArrayLit && (*e).rhs != null {
            return is_const_expr(s, (*e).rhs, cur);
        }
        return true;
    }
    return false;

    }
}

fn is_untyped(e: *mut Expr) -> bool {
    unsafe {
    if e == null {
        return false;
    }
    if (*e).kind == E::IntLit {
        return true;
    }
    if (*e).kind == E::Unary {
        if (*e).op == T::Minus || (*e).op == T::Bang {
            return is_untyped((*e).lhs);
        }
    }
    if (*e).kind == E::Binary {
        let op: T = (*e).op;
        if op == T::Plus || op == T::Minus || op == T::Star || op == T::Slash
            || op == T::Percent || op == T::Amp || op == T::Pipe || op == T::Caret
            || op == T::Shl || op == T::Shr {
            return is_untyped((*e).lhs) && is_untyped((*e).rhs);
        }
    }
    return false;

    }
}

fn is_place(e: *mut Expr) -> bool {
    unsafe {
    if e == null {
        return false;
    }
    let k: E = (*e).kind;
    if k == E::Ident || k == E::Field || k == E::Index {
        return true;
    }
    return k == E::Unary && (*e).op == T::Star;

    }
}

fn place_mut(s: *mut Sem, e: *mut Expr) -> bool {
    unsafe {
    if e == null {
        return false;
    }
    let k: E = (*e).kind;
    if k == E::Ident {
        if (*e).decl == null {
            return false;
        }
        return (*((*e).decl)).is_mut;
    }
    if k == E::Field || k == E::Index {
        return place_mut(s, (*e).lhs);
    }
    if k == E::Unary && (*e).op == T::Star {
        let t: *mut Type = (*e).opty;
        return t != null && (*t).kind == K::Ptr && (*t).mutable;
    }
    return false;

    }
}

fn type_ptr_elem(t: *mut Type) -> *mut Type {
    unsafe {
    if t == null {
        // A previous stage already reported a parse error. Return a concrete
        // type so later passes never dereference null.
        return t;
    }
    return (*t).elem;

    }
}

// Semantic recursion bound. Flat left-deep operator chains are parsed
// iteratively, so the parser's own E0111 guard never sees them; without this
// the check walk of a 4500-term chain recurses until the stack dies. The
// oracle uses the same limit, code, and message.
fn check_expr(s: *mut Sem, e: *mut Expr, expected: *mut Type) -> *mut Type {
    unsafe {
    if e == null {
        return check_expr_inner(s, e, expected);
    }
    if (*s).depth >= 64 {
        if !(*s).depth_reported {
            (*s).depth_reported = true;
            sdiagc(s, "E0111", (*e).file, (*e).line, (*e).col, "expression nesting depth exceeds the limit of 64");
        }
        let bad: *mut Type = type_new((*s).a, K::I32);
        (*e).ty = bad;
        return bad;
    }
    (*s).depth = (*s).depth + 1;
    let t: *mut Type = check_expr_inner(s, e, expected);
    (*s).depth = (*s).depth - 1;
    return t;

    }
}

fn check_expr_inner(s: *mut Sem, e: *mut Expr, expected: *mut Type) -> *mut Type {
    unsafe {
    if e == null {
        // A previous stage already reported a parse error. Return a concrete
        // type so later passes never dereference null (the crash this used to
        // cause: `print(unsafe { ... })`, fixed in the P2 workstream).
        return type_new((*s).a, K::I32);
    }
    if expected != null && !type_ok(s, expected) {
        sdiag(s, (*e).file, (*e).line, (*e).col, "internal: invalid expected type two");
        let bad: *mut Type = type_new((*s).a, K::I32);
        (*e).ty = bad;
        return bad;
    }
    let k: E = (*e).kind;
    if k == E::IntLit {
        if expected != null && type_is_int(expected) {
            if ((*e).ival as u64) > int_max_literal((*expected).kind) {
                sdiagc(s, "E0215", (*e).file, (*e).line, (*e).col, "integer literal does not fit in the annotated type");
            }
            (*e).ty = expected;
            return expected;
        }
        if ((*e).ival as u64) > 2147483647 {
            sdiagc(s, "E0215", (*e).file, (*e).line, (*e).col, "integer literal does not fit in `i32`");
        }
        let t: *mut Type = type_new((*s).a, K::I32);
        (*e).ty = t;
        return t;
    }
    if k == E::FloatLit {
        let mut kind: K = K::F64;
        if expected != null && ((*expected).kind == K::F32 || (*expected).kind == K::F64) {
            kind = (*expected).kind;
        }
        let t: *mut Type = type_new((*s).a, kind);
        (*e).ty = t;
        return t;
    }
    if k == E::StrLit {
        if expected != null && (*expected).kind == K::Array && (*((*expected).elem)).kind == K::U8
            && (*expected).len == len((*e).text) {
            (*e).ty = expected;
            return expected;
        }
        let t: *mut Type = type_new((*s).a, K::Str);
        (*e).ty = t;
        return t;
    }
    if k == E::CStrLit {
        let t: *mut Type = type_new((*s).a, K::CStr);
        (*e).ty = t;
        return t;
    }
    if k == E::CharLit {
        let t: *mut Type = type_new((*s).a, K::Char);
        (*e).ty = t;
        return t;
    }
    if k == E::BoolLit {
        let t: *mut Type = type_new((*s).a, K::Bool);
        (*e).ty = t;
        return t;
    }
    if k == E::NullLit {
        if expected != null && type_is_ptr_like(expected) {
            (*e).ty = expected;
            return expected;
        }
        sdiag(s, (*e).file, (*e).line, (*e).col, "cannot infer the type of null");
        let t: *mut Type = type_new((*s).a, K::Ptr);
        (*e).ty = t;
        return t;
    }
    if k == E::Ident {
        let d: *mut Decl = lookup(s, (*e).name);
        if d == null {
            if builtin_id((*e).name) != 0 {
                sdiagc_name(s, "E0218", (*e).file, (*e).line, (*e).col,
                    "builtin", (*e).name, " cannot be used as a value");
            } else {
                sdiagc(s, "E0201", (*e).file, (*e).line, (*e).col, "undefined name");
            }
            let t: *mut Type = type_new((*s).a, K::I32);
            (*e).ty = t;
            return t;
        }
        return decl_value_type(s, e, d);
    }
    if k == E::Path {
        let mut qb: Buf = rt_buf((*s).a);
        let qbp: *mut Buf = &mut qb;
        rt_s(qbp, (*e).name);
        rt_s(qbp, "$");
        rt_s(qbp, (*e).field);
        let qname: str = rt_view(qbp);
        if !rt_eq((*e).text, "") {
            let d: *mut Decl = sem_find(s, qname);
            if d == null || (*d).kind != D::Enum {
                sdiag(s, (*e).file, (*e).line, (*e).col, "unknown enum");
                let t: *mut Type = type_new((*s).a, K::I32);
                (*e).ty = t;
                return t;
            }
            if !visible(s, d) {
                sdiag(s, (*e).file, (*e).line, (*e).col, "item is private to its module");
            }
            let v: *mut Variant = find_variant(d, (*e).text);
            if v == null {
                sdiag(s, (*e).file, (*e).line, (*e).col, "unknown enum variant");
                let t: *mut Type = type_new((*s).a, K::I32);
                (*e).ty = t;
                return t;
            }
            (*e).decl = d;
            (*e).index = (*v).value as i32;
            let t: *mut Type = type_new((*s).a, K::Enum);
            (*t).decl = d;
            (*e).ty = t;
            return t;
        }
        let item: *mut Decl = sem_find(s, qname);
        if item != null && (*item).kind != D::Enum {
            return decl_value_type(s, e, item);
        }
        let d: *mut Decl = lookup(s, (*e).name);
        if d == null || (*d).kind != D::Enum {
            sdiag(s, (*e).file, (*e).line, (*e).col, "unknown enum");
            let t: *mut Type = type_new((*s).a, K::I32);
            (*e).ty = t;
            return t;
        }
        if !visible(s, d) {
            sdiag(s, (*e).file, (*e).line, (*e).col, "item is private to its module");
        }
        let v: *mut Variant = find_variant(d, (*e).field);
        if v == null {
            sdiag(s, (*e).file, (*e).line, (*e).col, "unknown enum variant");
            let t: *mut Type = type_new((*s).a, K::I32);
            (*e).ty = t;
            return t;
        }
        (*e).decl = d;
        (*e).index = (*v).value as i32;
        let t: *mut Type = type_new((*s).a, K::Enum);
        (*t).decl = d;
        (*e).ty = t;
        return t;
    }
    if k == E::Call {
        return check_call(s, e, expected);
    }
    if k == E::Index {
        let bt: *mut Type = resolve_type(s, check_expr(s, (*e).lhs, null));
        let mut elem: *mut Type = null;
        if (*bt).kind == K::Array || (*bt).kind == K::Slice || (*bt).kind == K::Vec {
            elem = (*bt).elem;
        } else if (*bt).kind == K::Str {
            elem = type_new((*s).a, K::U8);
        } else {
            sdiagc(s, "E0213", (*e).file, (*e).line, (*e).col, "indexing requires an array, slice, str, or vec");
            elem = type_new((*s).a, K::I32);
        }
        let ut: *mut Type = type_new((*s).a, K::Usize);
        let it: *mut Type = resolve_type(s, check_expr(s, (*e).rhs, ut));
        if !type_compat(ut, it) {
            sdiagc(s, "E0213", (*e).file, (*e).line, (*e).col, "index must be usize");
        }
        if (*e).rhs != null && (*bt).kind == K::Array && (*((*e).rhs)).kind == E::IntLit {
            let v: i64 = (*((*e).rhs)).ival;
            if v < 0 || v >= (*bt).len as i64 {
                sdiagc(s, "E0222", (*((*e).rhs)).file, (*((*e).rhs)).line, (*((*e).rhs)).col, "array index is out of bounds");
            }
        }
        (*e).opty = bt;
        (*e).ty = elem;
        return elem;
    }
    if k == E::SliceRange {
        let bt: *mut Type = resolve_type(s, check_expr(s, (*e).lhs, null));
        let bk: K = (*bt).kind;
        let mut res: *mut Type = null;
        if bk == K::Array {
            res = type_new((*s).a, K::Slice);
            (*res).elem = (*bt).elem;
        } else if bk == K::Slice || bk == K::Str {
            res = bt;
        } else {
            sdiagc(s, "E0213", (*e).file, (*e).line, (*e).col, "cannot slice a value of this type");
            res = type_new((*s).a, K::Slice);
            (*res).elem = type_new((*s).a, K::I32);
        }
        let ut: *mut Type = type_new((*s).a, K::Usize);
        if (*e).rhs != null {
            let st: *mut Type = resolve_type(s, check_expr(s, (*e).rhs, ut));
            if !type_compat(ut, st) {
                sdiagc(s, "E0213", (*((*e).rhs)).file, (*((*e).rhs)).line, (*((*e).rhs)).col, "slice bound must be usize");
            }
        }
        if (*e).args != null {
            let et: *mut Type = resolve_type(s, check_expr(s, (*e).args, ut));
            if !type_compat(ut, et) {
                sdiagc(s, "E0213", (*((*e).args)).file, (*((*e).args)).line, (*((*e).args)).col, "slice bound must be usize");
            }
        }
        let mut start_const: bool = true;
        let mut start_lit: i64 = 0;
        if (*e).rhs != null {
            if (*((*e).rhs)).kind == E::IntLit {
                start_lit = (*((*e).rhs)).ival;
            } else {
                start_const = false;
            }
        }
        // A string literal spliced by `[a..b]` has a known length, so its
        // bounds are checked exactly like an array's (the oracle does this).
        let mut bound_len: i64 = 0 - 1;
        if bk == K::Array {
            bound_len = (*bt).len as i64;
        } else if bk == K::Str && (*e).lhs != null && (*((*e).lhs)).kind == E::StrLit {
            bound_len = len((*((*e).lhs)).text) as i64;
        }
        if bound_len >= 0 && start_const && start_lit > bound_len {
            sdiagc(s, "E0222", (*e).file, (*e).line, (*e).col, "slice start exceeds length");
        }
        if (*e).args != null && (*((*e).args)).kind == E::IntLit {
            let end_lit: i64 = (*((*e).args)).ival;
            if start_const && start_lit > end_lit {
                sdiagc(s, "E0222", (*e).file, (*e).line, (*e).col, "slice start is greater than end");
            }
            if bound_len >= 0 && end_lit > bound_len {
                sdiagc(s, "E0222", (*e).file, (*e).line, (*e).col, "slice end exceeds length");
            }
        }
        (*e).opty = bt;
        (*e).ty = res;
        return res;
    }
    if k == E::Field {
        let bt: *mut Type = resolve_type(s, check_expr(s, (*e).lhs, null));
        if (*bt).kind != K::Struct || (*bt).decl == null {
            sdiagc(s, "E0227", (*e).file, (*e).line, (*e).col, "field access requires a struct");
            let t: *mut Type = type_new((*s).a, K::I32);
            (*e).ty = t;
            return t;
        }
        let f: *mut Field = find_field((*bt).decl, (*e).field);
        if f == null {
            sdiagc(s, "E0227", (*e).file, (*e).line, (*e).col, "unknown field");
            let t: *mut Type = type_new((*s).a, K::I32);
            (*e).ty = t;
            return t;
        }
        (*e).index = (*f).index;
        (*e).ival = (*f).offset as i64;
        (*e).opty = bt;
        (*e).ty = (*f).ty;
        return (*f).ty;
    }
    if k == E::Unary {
        let op: T = (*e).op;
        if op == T::Amp {
            // `&name` where `name` is a function yields the function pointer,
            // not a pointer to a place.
            if (*e).lhs != null && (*((*e).lhs)).kind == E::Ident {
                let fd: *mut Decl = lookup(s, (*((*e).lhs)).name);
                if fd != null && (*fd).kind == D::Func {
                    let ft: *mut Type = decl_fn_type(s, fd);
                    (*((*e).lhs)).decl = fd;
                    (*((*e).lhs)).ty = ft;
                    (*e).opty = ft;
                    (*e).ty = ft;
                    return ft;
                }
            }
            let bt: *mut Type = resolve_type(s, check_expr(s, (*e).lhs, null));
            if (*e).is_mut && !place_mut(s, (*e).lhs) {
                sdiagc(s, "E0220", (*e).file, (*e).line, (*e).col, "cannot take a mutable reference to this place");
            }
            (*e).opty = bt;
            if expected != null && (*expected).kind == K::Slice && (*bt).kind == K::Array
                && type_eq((*expected).elem, (*bt).elem) {
                (*e).ty = expected;
                return expected;
            }
            let t: *mut Type = type_ptr((*s).a, bt, (*e).is_mut);
            (*e).ty = t;
            return t;
        }
        if op == T::Star {
            let bt: *mut Type = resolve_type(s, check_expr(s, (*e).lhs, null));
            if !type_is_ptr(bt) {
                sdiag(s, (*e).file, (*e).line, (*e).col, "dereference requires a pointer");
                let t: *mut Type = type_new((*s).a, K::I32);
                (*e).ty = t;
                return t;
            }
            if (*s).unsafe_depth == 0 {
                sdiagc(s, "E0209", (*e).file, (*e).line, (*e).col, "dereference requires unsafe");
            }
            (*e).opty = bt;
            if !type_is_ptr(bt) {
                let bad: *mut Type = type_new((*s).a, K::I32);
                (*e).ty = bad;
                return bad;
            }
            (*e).ty = type_ptr_elem(bt);
            return (*e).ty;
        }
        if op == T::Minus {
            if (*e).lhs != null && (*(*e).lhs).kind == E::IntLit {
                let lit: *mut Expr = (*e).lhs;
                let mut et: *mut Type = null;
                if expected != null && type_is_int(expected) {
                    et = resolve_type(s, expected);
                } else {
                    et = type_new((*s).a, K::I32);
                }
                let v: u64 = (*lit).ival as u64;
                // The oracle accepts `max + 1` for signed targets (so MIN is
                // spellable) and any magnitude for unsigned targets.
                let lim: u64 = int_max_literal((*et).kind);
                if type_is_signed(et) && v > lim + 1 {
                    sdiagc(s, "E0215", (*lit).file, (*lit).line, (*lit).col, "integer literal does not fit in the annotated type");
                }
                (*lit).ty = et;
                (*e).opty = et;
                (*e).ty = et;
                return et;
            }
            let bt: *mut Type = resolve_type(s, check_expr(s, (*e).lhs, expected));
            if !type_is_int(bt) && !type_is_float(bt) {
                sdiag(s, (*e).file, (*e).line, (*e).col, "unary minus requires a number");
            }
            (*e).opty = bt;
            (*e).ty = bt;
            return bt;
        }
        let bt: *mut Type = resolve_type(s, check_expr(s, (*e).lhs, null));
        if (*bt).kind == K::Bool {
            (*e).opty = bt;
            (*e).ty = bt;
            return bt;
        }
        if !type_is_int(bt) {
            sdiag(s, (*e).file, (*e).line, (*e).col, "operator ! requires bool or an integer");
        }
        (*e).opty = bt;
        (*e).ty = bt;
        return bt;
    }
    if k == E::Binary {
        return check_binary(s, e, expected);
    }
    if k == E::Cast {
        let tt: *mut Type = resolve_type(s, (*e).type_arg);
        let bt: *mut Type = resolve_type(s, check_expr(s, (*e).lhs, null));
        let from_i: bool = type_is_int(bt);
        let to_i: bool = type_is_int(tt);
        let from_p: bool = type_is_ptr_like(bt);
        let to_p: bool = type_is_ptr_like(tt);
        let from_f: bool = type_is_float(bt);
        let to_f: bool = type_is_float(tt);
        let from_n: bool = type_is_num(bt);
        let to_n: bool = type_is_num(tt);
        if (*bt).kind == K::Enum && to_i {
            // enum -> integer
        } else if from_i && to_i {
            // integer -> integer
        } else if from_p && to_p {
            // pointer -> pointer
        } else if (from_n && to_f) || (from_f && to_n) || (from_f && to_f) {
            // integer <-> float and float <-> float
        } else if ((*bt).kind == K::CStr && (*tt).kind == K::Str) {
            // `c"..." as str`: length is computed at runtime.
        } else if (from_i && to_p) || (from_p && to_i) {
            if (*s).unsafe_depth == 0 {
                sdiagc(s, "E0209", (*e).file, (*e).line, (*e).col, "integer/pointer casts require unsafe");
            }
        } else {
            sdiagc(s, "E0210", (*e).file, (*e).line, (*e).col, "invalid cast");
        }
        (*e).opty = bt;
        (*e).ty = tt;
        return tt;
    }
    if k == E::Sizeof || k == E::Alignof || k == E::Offsetof {
        let tt: *mut Type = resolve_type(s, (*e).type_arg);
        if k == E::Sizeof {
            (*e).ival = type_size(s, tt) as i64;
        } else if k == E::Alignof {
            (*e).ival = type_align(s, tt) as i64;
        } else {
            if (*tt).kind == K::Struct && (*tt).decl != null {
                let f: *mut Field = find_field((*tt).decl, (*e).field);
                if f != null {
                    if (*f).bit_width > 0 {
                        sdiagc(s, "E0203", (*e).file, (*e).line, (*e).col, "offsetof cannot be applied to a bitfield");
                    } else {
                        (*e).ival = (*f).offset as i64;
                    }
                }
            }
        }
        let t: *mut Type = type_new((*s).a, K::Usize);
        (*e).opty = tt;
        (*e).ty = t;
        return t;
    }
    if k == E::CompoundLit {
        let tt: *mut Type = resolve_type(s, (*e).type_arg);
        let tk: K = (*tt).kind;
        if tk == K::Struct {
            let d: *mut Decl = (*tt).decl;
            let mut arg: *mut Expr = (*e).args;
            while arg != null {
                let fld: *mut Field = find_field(d, (*arg).sfield);
                if fld == null {
                    sdiagc(s, "E0227", (*arg).file, (*arg).line, (*arg).col, "unknown field");
                } else {
                    let vt: *mut Type = resolve_type(s, check_expr(s, arg, (*fld).ty));
                    if !type_compat((*fld).ty, vt) {
                        sdiag(s, (*arg).file, (*arg).line, (*arg).col, "field type mismatch");
                    }
                }
                arg = (*arg).next;
            }
        } else if tk == K::Array {
            let elem: *mut Type = (*tt).elem;
            let mut arg: *mut Expr = (*e).args;
            while arg != null {
                if (*arg).index < 0 || (*arg).index as i64 >= (*tt).len as i64 {
                    sdiagc(s, "E0222", (*arg).file, (*arg).line, (*arg).col, "designated index is out of bounds");
                }
                let vt: *mut Type = resolve_type(s, check_expr(s, arg, elem));
                if !type_compat(elem, vt) {
                    sdiagc(s, "E0203", (*arg).file, (*arg).line, (*arg).col, "compound literal element type mismatch");
                }
                arg = (*arg).next;
            }
        } else {
            sdiagc(s, "E0100", (*e).file, (*e).line, (*e).col, "compound literal requires a struct or array type");
        }
        (*e).opty = tt;
        (*e).ty = tt;
        return tt;
    }
    if k == E::StructLit {
        let d: *mut Decl = lookup(s, (*e).name);
        if d == null || (*d).kind != D::Struct {
            sdiag(s, (*e).file, (*e).line, (*e).col, "unknown struct type");
            let t: *mut Type = type_new((*s).a, K::I32);
            (*e).ty = t;
            return t;
        }
        let st: *mut Type = type_new((*s).a, K::Struct);
        (*st).decl = d;
        let mut nargs: i32 = 0;
        let mut arg: *mut Expr = (*e).args;
        while arg != null {
            let f: *mut Field = find_field(d, (*arg).sfield);
            if f == null {
                sdiagc(s, "E0227", (*arg).file, (*arg).line, (*arg).col, "unknown field");
            } else {
                let vt: *mut Type = resolve_type(s, check_expr(s, arg, (*f).ty));
                if !type_compat((*f).ty, vt) {
                    sdiag(s, (*arg).file, (*arg).line, (*arg).col, "field type mismatch");
                }
            }
            nargs = nargs + 1;
            arg = (*arg).next;
        }
        if (*d).is_union {
            if nargs != 1 {
                sdiagc(s, "E0229", (*e).file, (*e).line, (*e).col, "a union literal initializes exactly one field");
            }
        } else {
            let mut f: *mut Field = (*d).fields;
            while f != null {
                let mut found: bool = false;
                let mut arg2: *mut Expr = (*e).args;
                while arg2 != null {
                    if rt_eq((*arg2).sfield, (*f).name) {
                        found = true;
                    }
                    arg2 = (*arg2).next;
                }
                if !found {
                    sdiagc(s, "E0229", (*e).file, (*e).line, (*e).col, "missing struct field");
                }
                f = (*f).next;
            }
        }
        (*e).ty = st;
        return st;
    }
    if k == E::ArrayLit {
        let mut elem: *mut Type = null;
        if expected != null && (*expected).kind == K::Array {
            elem = (*expected).elem;
        }
        if (*e).index == 1 {
            let first: *mut Expr = (*e).args;
            if elem == null {
                elem = resolve_type(s, check_expr(s, first, null));
            } else {
                check_expr(s, first, elem);
            }
            let count: usize = eval_int(s, (*e).rhs) as usize;
            (*e).ival = count as i64;
            let t: *mut Type = type_array((*s).a, elem, count, null);
            (*e).ty = t;
            return t;
        }
        let mut n: usize = 0;
        let mut arg: *mut Expr = (*e).args;
        while arg != null {
            if elem == null {
                elem = resolve_type(s, check_expr(s, arg, null));
            } else {
                let at: *mut Type = resolve_type(s, check_expr(s, arg, elem));
                if !type_compat(elem, at) {
                    sdiag(s, (*arg).file, (*arg).line, (*arg).col, "array element type mismatch");
                }
            }
            n = n + 1;
            arg = (*arg).next;
        }
        let t: *mut Type = type_array((*s).a, elem, n, null);
        (*e).ty = t;
        return t;
    }
    let t: *mut Type = type_new((*s).a, K::Void);
    (*e).ty = t;
    return t;

    }
}

fn ck(s: *mut Sem, e: *mut Expr, expected: *mut Type) -> *mut Type {
    unsafe {
    let t: *mut Type = check_expr(s, e, expected);
    if !type_ok(s, t) {
        let mut f: i32 = 0;
        let mut l: i32 = 0;
        let mut c: i32 = 0;
        if e != null { f = (*e).file; l = (*e).line; c = (*e).col; }
        sdiag(s, f, l, c, "internal: bad type from subexpression");
        return type_new((*s).a, K::I32);
    }
    return t;
    }
}

fn check_binary(s: *mut Sem, e: *mut Expr, expected: *mut Type) -> *mut Type {
    unsafe {
    // A parse error can leave one operand null; the diagnostic is already
    // recorded, so return a placeholder instead of dereferencing null.
    if (*e).lhs == null || (*e).rhs == null {
        let t: *mut Type = type_new((*s).a, K::I32);
        (*e).ty = t;
        return t;
    }
    if expected != null && !type_ok(s, expected) {
        sdiag(s, (*e).file, (*e).line, (*e).col, "internal: invalid expected type");
        let bad: *mut Type = type_new((*s).a, K::I32);
        (*e).ty = bad;
        return bad;
    }
    let op: T = (*e).op;
    if op == T::AmpAmp || op == T::PipePipe {
        let bt: *mut Type = type_new((*s).a, K::Bool);
        let t1: *mut Type = resolve_type(s, ck(s, (*e).lhs, bt));
        let t2: *mut Type = resolve_type(s, ck(s, (*e).rhs, bt));
        if (*t1).kind != K::Bool || (*t2).kind != K::Bool {
            sdiag(s, (*e).file, (*e).line, (*e).col, "logical operators require bool");
        }
        (*e).opty = bt;
        (*e).ty = bt;
        return bt;
    }
    let is_cmp: bool = op == T::EqEq || op == T::Ne || op == T::Lt || op == T::Le || op == T::Gt || op == T::Ge;
    if is_cmp {
        let mut t1: *mut Type = null;
        let mut t2: *mut Type = null;
        let lhs_null: bool = (*((*e).lhs)).kind == E::NullLit;
        let rhs_null: bool = (*((*e).rhs)).kind == E::NullLit;
        if lhs_null {
            t2 = resolve_type(s, ck(s, (*e).rhs, null));
            if type_is_ptr_like(t2) {
                t1 = resolve_type(s, ck(s, (*e).lhs, t2));
            } else {
                sdiag(s, (*e).file, (*e).line, (*e).col, "null comparison requires a pointer");
                t1 = t2;
            }
        } else {
            t1 = resolve_type(s, ck(s, (*e).lhs, null));
            if rhs_null {
                if type_is_ptr_like(t1) {
                    t2 = resolve_type(s, ck(s, (*e).rhs, t1));
                } else {
                    sdiag(s, (*e).file, (*e).line, (*e).col, "null comparison requires a pointer");
                    t2 = t1;
                }
            } else {
                t2 = resolve_type(s, ck(s, (*e).rhs, t1));
            }
            if is_untyped((*e).lhs) && type_is_int(t2) {
                t1 = resolve_type(s, ck(s, (*e).lhs, t2));
            }
        }
        let ptr_cmp: bool = type_is_ptr_like(t1) && type_is_ptr_like(t2);
        let ok: bool = type_compat(t1, t2) || type_compat(t2, t1);
        if !ok {
            sdiag(s, (*e).file, (*e).line, (*e).col, "comparison operands have different types");
        }
        if ptr_cmp && op != T::EqEq && op != T::Ne {
            sdiag(s, (*e).file, (*e).line, (*e).col, "pointer ordering is not allowed");
        }
        let bt: *mut Type = type_new((*s).a, K::Bool);
        (*e).opty = t1;
        (*e).ty = bt;
        return bt;
    }
    let mut t1: *mut Type = null;
    // The left operand is checked exactly once. An untyped integer literal
    // cannot be a pointer, and checking it without the expected type would
    // reject large literals such as `(u64::MAX - d) / base` before the
    // expected type reaches them, so the type comes from the normal path
    // (which honours `expected`) and pointer detection happens afterwards.
    if expected != null && (type_is_int(expected) || type_is_float(expected)) {
        t1 = resolve_type(s, ck(s, (*e).lhs, expected));
    } else {
        t1 = resolve_type(s, ck(s, (*e).lhs, null));
    }
    // Pointer arithmetic: `*T + usize` / `*T - usize`. This used to pre-check
    // the left operand and then check it again below, so every level of a
    // left-deep `+`/`-` chain walked its left subtree twice: exponential in
    // the chain length (see cases/positive/pointer_chain.cx).
    if (op == T::Plus || op == T::Minus) && type_is_ptr(t1) {
        let ut: *mut Type = type_new((*s).a, K::Usize);
        let off: *mut Type = resolve_type(s, ck(s, (*e).rhs, ut));
        if !type_compat(ut, off) {
            sdiag(s, (*e).file, (*e).line, (*e).col, "pointer arithmetic requires a usize offset");
        }
        if (*s).unsafe_depth == 0 {
            sdiagc(s, "E0209", (*e).file, (*e).line, (*e).col, "pointer arithmetic requires unsafe");
        }
        (*e).opty = t1;
        (*e).ty = t1;
        return t1;
    }
    let t2: *mut Type = resolve_type(s, ck(s, (*e).rhs, t1));
    // An untyped integer literal adopts the type of the other operand. Skip
    // the re-check when the literal already has that type; re-checking a
    // pure-literal subtree once per enclosing operator was the second
    // exponential path and duplicated its diagnostics.
    if is_untyped((*e).lhs) && type_is_int(t2) && !type_eq(t1, t2) {
        t1 = resolve_type(s, ck(s, (*e).lhs, t2));
    }
    if type_is_float(t1) || type_is_float(t2) {
        if !type_is_float(t1) || !type_is_float(t2) || !type_eq(t1, t2) {
            sdiagc(s, "E0203", (*((*e).rhs)).file, (*((*e).rhs)).line, (*((*e).rhs)).col, "arithmetic operands have different types");
        } else if op != T::Plus && op != T::Minus && op != T::Star
            && op != T::Slash && op != T::Percent {
            sdiagc(s, "E0210", (*e).file, (*e).line, (*e).col, "operator is not defined for floating-point operands");
        }
        (*e).opty = t1;
        (*e).ty = t1;
        return t1;
    }
    if !type_is_int(t1) || !type_is_int(t2) {
        if (*t1).kind == K::Bool && (*t2).kind == K::Bool {
            let bt: *mut Type = type_new((*s).a, K::Bool);
            (*e).opty = bt;
            (*e).ty = bt;
            return bt;
        }
        sdiag(s, (*e).file, (*e).line, (*e).col, "arithmetic requires integer operands");
    }
    (*e).opty = t1;
    (*e).ty = t1;
    return t1;

    }
}

fn builtin_id(name: str) -> i32 {
    unsafe {
    if rt_eq(name, "print") { return 1; }
    if rt_eq(name, "len") { return 2; }
    if rt_eq(name, "syscall") { return 3; }
    if rt_eq(name, "alloc") { return 4; }
    if rt_eq(name, "free") { return 5; }
    if rt_eq(name, "assert") { return 6; }
    if rt_eq(name, "panic") { return 7; }
    if rt_eq(name, "data_ptr") { return 8; }
    if rt_eq(name, "str_from_raw") { return 9; }
    if rt_eq(name, "cstr_len") { return 10; }
    if rt_eq(name, "cstr_to_str") { return 11; }
    if rt_eq(name, "str_to_cstr") { return 12; }
    if rt_eq(name, "vec_new") { return 13; }
    if rt_eq(name, "vec_push") { return 14; }
    if rt_eq(name, "vec_free") { return 15; }
    if rt_eq(name, "vec_slice") { return 16; }
    if rt_eq(name, "read_file") { return 17; }
    if rt_eq(name, "write_file") { return 18; }
    if rt_eq(name, "asm") { return 19; }
    if rt_eq(name, "atomic_load") { return 20; }
    if rt_eq(name, "atomic_load_relaxed") { return 21; }
    if rt_eq(name, "atomic_store") { return 22; }
    if rt_eq(name, "atomic_store_relaxed") { return 23; }
    if rt_eq(name, "atomic_fetch_add") { return 24; }
    if rt_eq(name, "atomic_fetch_sub") { return 25; }
    if rt_eq(name, "atomic_fetch_and") { return 26; }
    if rt_eq(name, "atomic_fetch_or") { return 27; }
    if rt_eq(name, "atomic_fetch_xor") { return 28; }
    if rt_eq(name, "atomic_xchg") { return 29; }
    if rt_eq(name, "atomic_cas") { return 30; }
    if rt_eq(name, "atomic_fence") { return 31; }
    if rt_eq(name, "volatile_load") { return 32; }
    if rt_eq(name, "volatile_store") { return 33; }
    return 0;

    }
}

fn check_indirect_call(s: *mut Sem, e: *mut Expr, expected: *mut Type) -> *mut Type {
    unsafe {
    let ct: *mut Type = resolve_type(s, check_expr(s, (*e).lhs, null));
    if (*ct).kind != K::Fn {
        sdiagc(s, "E0218", (*e).file, (*e).line, (*e).col, "call target must be a function or function pointer");
        let bad: *mut Type = type_new((*s).a, K::I32);
        (*e).ty = bad;
        (*e).index = 0;
        (*e).decl = null;
        return bad;
    }
    let mut arg: *mut Expr = (*e).args;
    let mut par: *mut Type = (*ct).params;
    while par != null {
        if arg == null {
            sdiagc(s, "E0204", (*e).file, (*e).line, (*e).col, "missing function argument");
            break;
        }
        let pt: *mut Type = resolve_type(s, par);
        let at: *mut Type = resolve_type(s, check_expr(s, arg, pt));
        if !type_compat(pt, at) {
            sdiag(s, (*arg).file, (*arg).line, (*arg).col, "argument type mismatch");
        }
        arg = (*arg).next;
        par = (*par).next;
    }
    if arg != null {
        sdiagc(s, "E0204", (*e).file, (*e).line, (*e).col, "too many function arguments");
    }
    let rt: *mut Type = resolve_type(s, (*ct).ret);
    (*e).index = 0;
    (*e).decl = null;
    (*e).opty = ct;
    (*e).ty = rt;
    return rt;

    }
}

// True when an inline-asm constraint list declares an output (`=...`).
// LLVM passes the constraint string through verbatim; only the leading `=`
// matters to the CoreX type checker, matching the Rust reference compiler.
fn asm_has_output(constraints: str) -> bool {
    unsafe {
    let n: usize = len(constraints);
    let mut i: usize = 0;
    let mut at_start: bool = true;
    while i < n {
        let c: u8 = constraints[i];
        if c == 44 {
            at_start = true;
        } else if c == 32 || c == 9 {
            // leading whitespace in a constraint segment
        } else {
            if at_start && c == 61 {
                return true;
            }
            at_start = false;
        }
        i = i + 1;
    }
    return false;

    }
}

fn check_asm(s: *mut Sem, e: *mut Expr) -> *mut Type {
    unsafe {
    let arg0: *mut Expr = (*e).args;
    if arg0 == null {
        sdiagc(s, "E0204", (*e).file, (*e).line, (*e).col, "`asm` requires a template string");
        let vt0: *mut Type = type_new((*s).a, K::Void);
        (*e).ty = vt0;
        return vt0;
    }
    if (*s).unsafe_depth == 0 {
        sdiagc(s, "E0209", (*e).file, (*e).line, (*e).col, "`asm` is only allowed inside an `unsafe` block");
    }
    let k0: E = (*arg0).kind;
    let mut template: str = "";
    if k0 == E::StrLit || k0 == E::CStrLit {
        template = (*arg0).text;
    } else {
        sdiagc(s, "E0203", (*arg0).file, (*arg0).line, (*arg0).col, "`asm` template must be a string literal");
    }
    let second: *mut Expr = (*arg0).next;
    let mut constraints: str = "";
    let mut first_operand: *mut Expr = second;
    if second != null {
        let k1: E = (*second).kind;
        if k1 == E::StrLit || k1 == E::CStrLit {
            constraints = (*second).text;
            first_operand = (*second).next;
        }
    }
    let mut arg: *mut Expr = first_operand;
    while arg != null {
        let t: *mut Type = resolve_type(s, check_expr(s, arg, null));
        if !type_is_int(t) && !type_is_ptr_like(t) {
            sdiagc(s, "E0216", (*arg).file, (*arg).line, (*arg).col,
                "inline assembly operands must be integers or pointers");
        }
        arg = (*arg).next;
    }
    (*e).text = template;
    (*e).sfield = constraints;
    (*e).index = 19;
    let mut ret: *mut Type = type_new((*s).a, K::Void);
    if asm_has_output(constraints) {
        ret = type_new((*s).a, K::Usize);
    }
    (*e).ty = ret;
    return ret;

    }
}

fn atomic_argc(bid: i32) -> i32 {
    unsafe {
    if bid == 20 || bid == 21 || bid == 32 {
        return 1;
    }
    if bid == 30 {
        return 3;
    }
    if bid == 31 {
        return 0;
    }
    return 2;

    }
}

fn atomic_is_load(bid: i32) -> bool {
    unsafe {
    return bid == 20 || bid == 21 || bid == 32;

    }
}

fn atomic_is_store(bid: i32) -> bool {
    unsafe {
    return bid == 22 || bid == 23 || bid == 33;

    }
}

fn check_atomic(s: *mut Sem, e: *mut Expr, name: str, bid: i32) -> *mut Type {
    unsafe {
    if (*s).unsafe_depth == 0 {
        sdiagc(s, "E0209", (*e).file, (*e).line, (*e).col, "atomic and volatile builtins require unsafe");
    }
    let mut nargs: i32 = 0;
    let mut arg: *mut Expr = (*e).args;
    while arg != null {
        nargs = nargs + 1;
        arg = (*arg).next;
    }
    let want: i32 = atomic_argc(bid);
    if nargs != want {
        sdiagc(s, "E0204", (*e).file, (*e).line, (*e).col, "atomic/volatile builtin argument count mismatch");
        let bad0: *mut Type = type_new((*s).a, K::I32);
        (*e).ty = bad0;
        return bad0;
    }
    if bid == 31 {
        let vt0: *mut Type = type_new((*s).a, K::Void);
        (*e).ty = vt0;
        return vt0;
    }
    let arg0: *mut Expr = (*e).args;
    let pt: *mut Type = resolve_type(s, check_expr(s, arg0, null));
    if (*pt).kind != K::Ptr || (*pt).elem == null {
        sdiagc(s, "E0203", (*arg0).file, (*arg0).line, (*arg0).col, "atomic/volatile builtin expects a pointer");
        let bad1: *mut Type = type_new((*s).a, K::I32);
        (*e).ty = bad1;
        return bad1;
    }
    let pointee: *mut Type = (*pt).elem;
    if type_is_aggregate(pointee) || (*pointee).kind == K::Void {
        sdiagc(s, "E0203", (*arg0).file, (*arg0).line, (*arg0).col,
            "atomic/volatile builtin requires an integer or pointer pointee");
    }
    if !atomic_is_load(bid) {
        let arg1: *mut Expr = (*arg0).next;
        if arg1 != null {
            let t1: *mut Type = resolve_type(s, check_expr(s, arg1, pointee));
            if !type_compat(pointee, t1) {
                sdiagc(s, "E0203", (*arg1).file, (*arg1).line, (*arg1).col, "atomic operand type mismatch");
            }
            if bid == 30 {
                let arg2: *mut Expr = (*arg1).next;
                if arg2 != null {
                    let t2: *mut Type = resolve_type(s, check_expr(s, arg2, pointee));
                    if !type_compat(pointee, t2) {
                        sdiagc(s, "E0203", (*arg2).file, (*arg2).line, (*arg2).col, "atomic operand type mismatch");
                    }
                }
            }
        }
    }
    let _ = name;
    if atomic_is_store(bid) || bid == 31 {
        let vt: *mut Type = type_new((*s).a, K::Void);
        (*e).ty = vt;
        return vt;
    }
    if bid == 30 {
        let bt2: *mut Type = type_new((*s).a, K::Bool);
        (*e).ty = bt2;
        return bt2;
    }
    (*e).ty = pointee;
    return pointee;

    }
}

fn check_call(s: *mut Sem, e: *mut Expr, expected: *mut Type) -> *mut Type {
    unsafe {
    if (*e).lhs == null {
        sdiag(s, (*e).file, (*e).line, (*e).col, "callee must be a function name");
        let t: *mut Type = type_new((*s).a, K::I32);
        (*e).ty = t;
        return t;
    }
    let lk: E = (*((*e).lhs)).kind;
    let mut name: str = "";
    if lk == E::Ident {
        name = (*((*e).lhs)).name;
        // A local binding shadows a function of the same name: that call is
        // indirect through the binding's function pointer.
        if lookup_local(s, name) != null {
            return check_indirect_call(s, e, expected);
        }
    } else if lk == E::Path && rt_eq((*((*e).lhs)).text, "") {
        let mut b: Buf = rt_buf((*s).a);
        let bp: *mut Buf = &mut b;
        rt_s(bp, (*((*e).lhs)).name);
        rt_s(bp, "$");
        rt_s(bp, (*((*e).lhs)).field);
        name = rt_view(bp);
    } else {
        return check_indirect_call(s, e, expected);
    }
    // A declared function shadows a builtin of the same name (the standard
    // library defines `free`, for example).
    let pre: *mut Decl = lookup(s, name);
    let mut bid: i32 = 0;
    if pre == null || (*pre).kind != D::Func {
        bid = builtin_id(name);
    }
    if bid != 0 {
        (*e).index = bid;
    } else {
        let d: *mut Decl = lookup(s, name);
        if d != null && (*d).kind == D::Func {
            if !visible(s, d) {
                // The oracle resolves visibility during name lookup, so a
                // private item is reported as undefined with its `a::b` name.
                let mut db: Buf = rt_buf((*s).a);
                let dbp: *mut Buf = &mut db;
                let mut ni: usize = 0;
                while ni < len(name) {
                    if name[ni] == 36 {
                        rt_s(dbp, "::");
                    } else {
                        rt_b(dbp, name[ni]);
                    }
                    ni = ni + 1;
                }
                let mut mb: Buf = rt_buf((*s).a);
                let mbp: *mut Buf = &mut mb;
                rt_s(mbp, "undefined item `");
                rt_s(mbp, rt_view(dbp));
                rt_s(mbp, "`");
                sdiagc(s, "E0201", (*e).file, (*e).line, (*e).col, rt_view(mbp));
            }
            (*e).decl = d;
            let mut arg: *mut Expr = (*e).args;
            let mut par: *mut Param = (*d).params;
            let mut n: i32 = 0;
            while par != null {
                if arg == null {
                    sdiagc(s, "E0204", (*e).file, (*e).line, (*e).col, "missing function argument");
                    break;
                }
                let pt: *mut Type = resolve_type(s, (*par).ty);
                let at: *mut Type = resolve_type(s, check_expr(s, arg, pt));
                if !type_compat(pt, at) {
                    sdiagc(s, "E0203", (*arg).file, (*arg).line, (*arg).col, "argument type mismatch");
                }
                arg = (*arg).next;
                par = (*par).next;
                n = n + 1;
            }
            if (*d).variadic {
                while arg != null {
                    let xt: *mut Type = resolve_type(s, check_expr(s, arg, null));
                    if (*xt).kind == K::Void || type_is_aggregate(xt) {
                        sdiag(s, (*arg).file, (*arg).line, (*arg).col, "variadic argument must be a scalar or pointer");
                    }
                    arg = (*arg).next;
                }
            } else if arg != null {
                sdiagc(s, "E0204", (*e).file, (*e).line, (*e).col, "too many function arguments");
            }
            let rt: *mut Type = resolve_type(s, (*d).ty);
            (*e).ty = rt;
            return rt;
        }
        return check_indirect_call(s, e, expected);
    }
    let ut: *mut Type = type_new((*s).a, K::Usize);
    if bid == 1 {
        let arg: *mut Expr = (*e).args;
        if arg == null || (*arg).next != null {
            sdiagc(s, "E0204", (*e).file, (*e).line, (*e).col, "print takes one argument");
        }
        if arg == null {
            let vt0: *mut Type = type_new((*s).a, K::Void);
            (*e).ty = vt0;
            return vt0;
        }
        let at: *mut Type = resolve_type(s, check_expr(s, arg, null));
        let kk: K = (*at).kind;
        let printable: bool = type_is_int(at) || kk == K::Bool || kk == K::Str || kk == K::CStr
            || (kk == K::Array && (*((*at).elem)).kind == K::U8)
            || (kk == K::Slice && (*((*at).elem)).kind == K::U8) || kk == K::Enum
            || kk == K::F32 || kk == K::F64;
        if !printable {
            sdiagc(s, "E0203", (*e).file, (*e).line, (*e).col, "print does not accept this type");
        }
        (*e).opty = at;
        let vt: *mut Type = type_new((*s).a, K::Void);
        (*e).ty = vt;
        return vt;
    }
    if bid == 2 {
        let arg: *mut Expr = (*e).args;
        if arg == null || (*arg).next != null {
            sdiagc(s, "E0204", (*e).file, (*e).line, (*e).col, "len takes one argument");
        }
        if arg == null {
            (*e).ty = ut;
            return ut;
        }
        let at: *mut Type = resolve_type(s, check_expr(s, arg, null));
        let kk: K = (*at).kind;
        if kk != K::Array && kk != K::Slice && kk != K::Str && kk != K::Vec {
            sdiag(s, (*e).file, (*e).line, (*e).col, "len requires an array, slice, str, or vec");
        }
        (*e).opty = at;
        (*e).ty = ut;
        return ut;
    }
    if bid == 3 {
        let mut n: i32 = 0;
        let mut arg: *mut Expr = (*e).args;
        while arg != null {
            let _ = resolve_type(s, check_expr(s, arg, ut));
            n = n + 1;
            arg = (*arg).next;
        }
        if n < 1 || n > 7 {
            sdiag(s, (*e).file, (*e).line, (*e).col, "syscall takes 1 to 7 arguments");
        }
        if (*s).unsafe_depth == 0 {
            sdiagc(s, "E0209", (*e).file, (*e).line, (*e).col, "syscall requires unsafe");
        }
        let t: *mut Type = type_new((*s).a, K::Isize);
        (*e).ty = t;
        return t;
    }
    if bid == 4 {
        let arg: *mut Expr = (*e).args;
        if arg == null || (*arg).next != null {
            sdiag(s, (*e).file, (*e).line, (*e).col, "alloc takes one argument");
        }
        let _ = resolve_type(s, check_expr(s, arg, ut));
        if (*s).unsafe_depth == 0 {
            sdiagc(s, "E0209", (*e).file, (*e).line, (*e).col, "alloc requires unsafe");
        }
        let u8t: *mut Type = type_new((*s).a, K::U8);
        let t: *mut Type = type_ptr((*s).a, u8t, true);
        (*e).ty = t;
        return t;
    }
    if bid == 5 {
        let arg: *mut Expr = (*e).args;
        if arg != null {
            let _ = resolve_type(s, check_expr(s, arg, null));
            if (*arg).next != null {
                let _ = resolve_type(s, check_expr(s, (*arg).next, ut));
            }
        }
        if (*s).unsafe_depth == 0 {
            sdiag(s, (*e).file, (*e).line, (*e).col, "free requires unsafe");
        }
        let vt: *mut Type = type_new((*s).a, K::Void);
        (*e).ty = vt;
        return vt;
    }
    if bid == 6 {
        let arg: *mut Expr = (*e).args;
        let bt: *mut Type = type_new((*s).a, K::Bool);
        let st: *mut Type = type_new((*s).a, K::Str);
        if arg != null {
            let _ = resolve_type(s, check_expr(s, arg, bt));
            if (*arg).next != null {
                let _ = resolve_type(s, check_expr(s, (*arg).next, st));
            }
        }
        let vt: *mut Type = type_new((*s).a, K::Void);
        (*e).ty = vt;
        return vt;
    }
    if bid == 7 {
        let arg: *mut Expr = (*e).args;
        let st: *mut Type = type_new((*s).a, K::Str);
        if arg != null {
            let at: *mut Type = resolve_type(s, check_expr(s, arg, st));
            let kk: K = (*at).kind;
            if kk != K::Str && !(kk == K::Slice && (*at).elem != null && (*((*at).elem)).kind == K::U8) {
                sdiagc(s, "E0203", (*arg).file, (*arg).line, (*arg).col, "panic message must be str or [u8]");
            }
        }
        let vt: *mut Type = type_new((*s).a, K::Void);
        (*e).ty = vt;
        return vt;
    }
    if bid == 8 {
        let arg: *mut Expr = (*e).args;
        if arg == null {
            sdiag(s, (*e).file, (*e).line, (*e).col, "data_ptr takes one argument");
            let u8z: *mut Type = type_new((*s).a, K::U8);
            let tz: *mut Type = type_ptr((*s).a, u8z, false);
            (*e).ty = tz;
            return tz;
        }
        let at: *mut Type = resolve_type(s, check_expr(s, arg, null));
        let kk: K = (*at).kind;
        if kk != K::Str && kk != K::Slice {
            sdiag(s, (*e).file, (*e).line, (*e).col, "data_ptr requires str or a slice");
        }
        let mut et: *mut Type = type_new((*s).a, K::U8);
        if kk == K::Slice && (*at).elem != null {
            et = (*at).elem;
        }
        let t: *mut Type = type_ptr((*s).a, et, false);
        (*e).opty = at;
        (*e).ty = t;
        return t;
    }
    if bid == 9 {
        let arg: *mut Expr = (*e).args;
        let u8t: *mut Type = type_new((*s).a, K::U8);
        let p8: *mut Type = type_ptr((*s).a, u8t, false);
        if arg != null {
            let _ = resolve_type(s, check_expr(s, arg, p8));
            if (*arg).next != null {
                let _ = resolve_type(s, check_expr(s, (*arg).next, ut));
            }
        }
        let t: *mut Type = type_new((*s).a, K::Str);
        (*e).ty = t;
        return t;
    }
    if bid == 10 {
        let arg: *mut Expr = (*e).args;
        let ct: *mut Type = type_new((*s).a, K::CStr);
        if arg != null {
            let _ = resolve_type(s, check_expr(s, arg, ct));
        }
        (*e).ty = ut;
        return ut;
    }
    if bid == 11 {
        let arg: *mut Expr = (*e).args;
        let ct: *mut Type = type_new((*s).a, K::CStr);
        if arg != null {
            let _ = resolve_type(s, check_expr(s, arg, ct));
        }
        let t: *mut Type = type_new((*s).a, K::Str);
        (*e).ty = t;
        return t;
    }
    if bid == 13 {
        let arg: *mut Expr = (*e).args;
        let cap_ty: *mut Type = type_new((*s).a, K::Usize);
        if arg == null || (*arg).next != null {
            sdiag(s, (*e).file, (*e).line, (*e).col, "vec_new takes one argument");
        }
        if arg != null {
            let at: *mut Type = resolve_type(s, check_expr(s, arg, cap_ty));
            if !type_compat(cap_ty, at) {
                sdiag(s, (*arg).file, (*arg).line, (*arg).col, "vec_new capacity must be usize");
            }
        }
        let mut elem: *mut Type = null;
        let mut inferred: bool = false;
        if expected != null {
            let ex: *mut Type = resolve_type(s, expected);
            if (*ex).kind == K::Vec {
                elem = (*ex).elem;
                inferred = true;
            }
        }
        if !inferred {
            sdiagc(s, "E0230", (*e).file, (*e).line, (*e).col, "cannot infer the element type of vec_new; annotate the binding or context");
            let bad: *mut Type = type_new((*s).a, K::I32);
            (*e).ty = bad;
            return bad;
        }
        if elem == null || (*elem).kind == K::Void {
            sdiag(s, (*e).file, (*e).line, (*e).col, "vec element type must not be void");
            let bad2: *mut Type = type_new((*s).a, K::I32);
            (*e).ty = bad2;
            return bad2;
        }
        let vt: *mut Type = type_vec((*s).a, elem);
        (*e).ty = vt;
        return vt;
    }
    if bid == 14 {
        let arg: *mut Expr = (*e).args;
        let mut elem: *mut Type = null;
        let mut okv: bool = false;
        if arg == null {
            sdiag(s, (*e).file, (*e).line, (*e).col, "vec_push takes two arguments");
            let vt0: *mut Type = type_new((*s).a, K::Void);
            (*e).ty = vt0;
            return vt0;
        }
        let at: *mut Type = resolve_type(s, check_expr(s, arg, null));
        if (*at).kind == K::Ptr && (*at).mutable && (*at).elem != null && (*(*at).elem).kind == K::Vec {
            elem = (*(*at).elem).elem;
            okv = true;
        } else {
            sdiag(s, (*arg).file, (*arg).line, (*arg).col, "vec_push expects &mut vec<T>");
        }
        let val: *mut Expr = (*arg).next;
        if val == null {
            sdiag(s, (*e).file, (*e).line, (*e).col, "vec_push takes two arguments");
        } else {
            if okv {
                let vt: *mut Type = resolve_type(s, check_expr(s, val, elem));
                if !type_compat(elem, vt) {
                    sdiagc(s, "E0203", (*val).file, (*val).line, (*val).col, "vec_push value type mismatch");
                }
            } else {
                let _ = resolve_type(s, check_expr(s, val, null));
            }
            if (*val).next != null {
                sdiag(s, (*e).file, (*e).line, (*e).col, "vec_push takes two arguments");
            }
        }
        let vt1: *mut Type = type_new((*s).a, K::Void);
        (*e).ty = vt1;
        return vt1;
    }
    if bid == 15 {
        let arg: *mut Expr = (*e).args;
        if arg == null {
            sdiag(s, (*e).file, (*e).line, (*e).col, "vec_free takes one argument");
        } else {
            let at2: *mut Type = resolve_type(s, check_expr(s, arg, null));
            if !((*at2).kind == K::Ptr && (*at2).mutable && (*at2).elem != null && (*(*at2).elem).kind == K::Vec) {
                sdiag(s, (*arg).file, (*arg).line, (*arg).col, "vec_free expects &mut vec<T>");
            }
            if (*arg).next != null {
                sdiag(s, (*e).file, (*e).line, (*e).col, "vec_free takes one argument");
            }
        }
        let vt2: *mut Type = type_new((*s).a, K::Void);
        (*e).ty = vt2;
        return vt2;
    }
    if bid == 16 {
        let arg: *mut Expr = (*e).args;
        let mut elem4: *mut Type = null;
        let mut ok4: bool = false;
        if arg == null {
            sdiag(s, (*e).file, (*e).line, (*e).col, "vec_slice takes one argument");
        } else {
            let at3: *mut Type = resolve_type(s, check_expr(s, arg, null));
            if (*at3).kind == K::Ptr && (*at3).elem != null && (*(*at3).elem).kind == K::Vec {
                elem4 = (*(*at3).elem).elem;
                ok4 = true;
            } else {
                sdiagc(s, "E0203", (*arg).file, (*arg).line, (*arg).col, "vec_slice expects a reference to vec<T>");
            }
            if (*arg).next != null {
                sdiag(s, (*e).file, (*e).line, (*e).col, "vec_slice takes one argument");
            }
        }
        if !ok4 || elem4 == null {
            let bad4: *mut Type = type_new((*s).a, K::I32);
            (*e).ty = bad4;
            return bad4;
        }
        let st: *mut Type = type_new((*s).a, K::Slice);
        (*st).elem = elem4;
        (*e).ty = st;
        return st;
    }
    if bid == 17 {
        let arg: *mut Expr = (*e).args;
        let u8r: *mut Type = type_new((*s).a, K::U8);
        let path_ty: *mut Type = type_new((*s).a, K::Slice);
        (*path_ty).elem = u8r;
        if arg == null || (*arg).next != null {
            sdiagc(s, "E0204", (*e).file, (*e).line, (*e).col, "read_file takes one argument");
        }
        if arg != null {
            let at: *mut Type = resolve_type(s, check_expr(s, arg, path_ty));
            let kk: K = (*at).kind;
            let okp: bool = kk == K::Str || (kk == K::Slice && (*at).elem != null && (*(*at).elem).kind == K::U8);
            if !okp {
                sdiagc(s, "E0203", (*arg).file, (*arg).line, (*arg).col, "read_file path must be str or [u8]");
            }
        }
        let vt: *mut Type = type_vec((*s).a, u8r);
        (*e).ty = vt;
        return vt;
    }
    if bid == 18 {
        let arg: *mut Expr = (*e).args;
        let u8w: *mut Type = type_new((*s).a, K::U8);
        let bytes_ty: *mut Type = type_new((*s).a, K::Slice);
        (*bytes_ty).elem = u8w;
        if arg == null || (*arg).next == null || (*(*arg).next).next != null {
            sdiagc(s, "E0204", (*e).file, (*e).line, (*e).col, "write_file takes two arguments");
        }
        if arg != null {
            let pt: *mut Type = resolve_type(s, check_expr(s, arg, bytes_ty));
            let pk: K = (*pt).kind;
            let okp2: bool = pk == K::Str || (pk == K::Slice && (*pt).elem != null && (*(*pt).elem).kind == K::U8);
            if !okp2 {
                sdiag(s, (*arg).file, (*arg).line, (*arg).col, "write_file path must be str or [u8]");
            }
            let de: *mut Expr = (*arg).next;
            if de != null {
                let dt: *mut Type = resolve_type(s, check_expr(s, de, bytes_ty));
                let dk: K = (*dt).kind;
                let okd: bool = dk == K::Str || (dk == K::Slice && (*dt).elem != null && (*(*dt).elem).kind == K::U8);
                if !okd {
                    sdiagc(s, "E0203", (*de).file, (*de).line, (*de).col, "write_file expects str or [u8] data");
                }
            }
        }
        let rt2: *mut Type = type_new((*s).a, K::I32);
        (*e).ty = rt2;
        return rt2;
    }
    if bid == 19 {
        return check_asm(s, e);
    }
    if bid >= 20 && bid <= 33 {
        return check_atomic(s, e, name, bid);
    }
    let u8t: *mut Type = type_new((*s).a, K::U8);
    let pm: *mut Type = type_ptr((*s).a, u8t, true);
    let st: *mut Type = type_new((*s).a, K::Str);
    let arg: *mut Expr = (*e).args;
    if arg != null {
        let _ = resolve_type(s, check_expr(s, arg, pm));
        if (*arg).next != null {
            let _ = resolve_type(s, check_expr(s, (*arg).next, ut));
            if (*(*arg).next).next != null {
                let _ = resolve_type(s, check_expr(s, (*(*arg).next).next, st));
            }
        }
    }
    if (*s).unsafe_depth == 0 {
        sdiag(s, (*e).file, (*e).line, (*e).col, "str_to_cstr requires unsafe");
    }
    let ct: *mut Type = type_new((*s).a, K::CStr);
    (*e).ty = ct;
    return ct;

    }
}

fn check_block(s: *mut Sem, head: *mut Stmt) {
    unsafe {
    scope_push(s);
    let mut st: *mut Stmt = head;
    while st != null {
        check_stmt(s, st);
        st = (*st).next;
    }
    scope_pop(s);

    }
}

fn check_stmt(s: *mut Sem, st: *mut Stmt) {
    unsafe {
    let k: S = (*st).kind;
    if k == S::Let {
        let mut t: *mut Type = null;
        if (*st).ty != null {
            t = resolve_type(s, (*st).ty);
        }
        let it: *mut Type = resolve_type(s, check_expr(s, (*st).expr, t));
        if t == null {
            t = it;
        } else if !type_compat(t, it) {
            let mut ef: i32 = (*st).file;
            let mut el: i32 = (*st).line;
            let mut ec: i32 = (*st).col;
            if (*st).expr != null {
                ef = (*((*st).expr)).file;
                el = (*((*st).expr)).line;
                ec = (*((*st).expr)).col;
            }
            sdiagc(s, "E0203", ef, el, ec, "initializer type mismatch");
        }
        if (*t).kind == K::Void && !rt_eq((*st).name, "_") {
            sdiag(s, (*st).file, (*st).line, (*st).col, "cannot bind a void value");
        }
        if (*t).kind == K::Array && (*t).len == 0 {
            sdiagc(s, "E0224", (*st).file, (*st).line, (*st).col, "zero-length arrays are only allowed as the last field of a struct (flexible array member)");
        }
        if !rt_eq((*st).name, "_") && scope_has_current(s, (*st).name) {
            sdiagc(s, "E0202", (*st).file, (*st).line, (*st).col, "duplicate declaration");
        }
        let d: *mut Decl = decl_new((*s).a, D::Var, (*st).name, (*st).file, (*st).line, (*st).col);
        (*d).ty = t;
        (*d).is_mut = (*st).is_mut;
        (*d).slot = (*s).slot;
        (*s).slot = (*s).slot + 1;
        (*st).decl = d;
        scope_add(s, d);
        return;
    }
    if k == S::Assign {
        let lt: *mut Type = resolve_type(s, check_expr(s, (*st).expr, null));
        let rt: *mut Type = resolve_type(s, check_expr(s, (*st).rhs, lt));
        if !type_compat(lt, rt) {
            sdiagc(s, "E0203", (*st).file, (*st).line, (*st).col, "assignment type mismatch");
        }
        if !is_place((*st).expr) {
            sdiag(s, (*st).file, (*st).line, (*st).col, "assignment target is not a place");
        } else if !place_mut(s, (*st).expr) {
            sdiagc(s, "E0205", (*st).file, (*st).line, (*st).col, "cannot assign to an immutable place");
        }
        if (*st).op != T::Eq && !type_is_int(lt) {
            let op: T = (*st).op;
            let float_ok: bool = type_is_float(lt)
                && (op == T::PlusEq || op == T::MinusEq || op == T::StarEq
                    || op == T::SlashEq || op == T::PercentEq);
            if !float_ok {
                sdiagc(s, "E0210", (*st).file, (*st).line, (*st).col,
                    "compound assignment requires an integer or a float arithmetic place");
            }
        }
        return;
    }
    if k == S::Expr {
        let _ = resolve_type(s, check_expr(s, (*st).expr, null));
        return;
    }
    if k == S::If {
        let bt: *mut Type = type_new((*s).a, K::Bool);
        let ct: *mut Type = resolve_type(s, check_expr(s, (*st).expr, bt));
        if (*ct).kind != K::Bool {
            sdiagc(s, "E0214", (*st).file, (*st).line, (*st).col, "if condition must be bool");
        }
        check_block(s, (*st).body);
        if (*st).els != null {
            check_stmt(s, (*st).els);
        }
        return;
    }
    if k == S::While {
        let bt: *mut Type = type_new((*s).a, K::Bool);
        let ct: *mut Type = resolve_type(s, check_expr(s, (*st).expr, bt));
        if (*ct).kind != K::Bool {
            sdiagc(s, "E0214", (*st).file, (*st).line, (*st).col, "while condition must be bool");
        }
        (*s).loop_depth = (*s).loop_depth + 1;
        check_block(s, (*st).body);
        (*s).loop_depth = (*s).loop_depth - 1;
        return;
    }
    if k == S::Loop {
        (*s).loop_depth = (*s).loop_depth + 1;
        check_block(s, (*st).body);
        (*s).loop_depth = (*s).loop_depth - 1;
        return;
    }
    if k == S::Break {
        if (*s).loop_depth == 0 && (*s).switch_depth == 0 {
            sdiagc(s, "E0207", (*st).file, (*st).line, (*st).col, "break outside a loop or switch");
        }
        return;
    }
    if k == S::Continue {
        if (*s).loop_depth == 0 {
            sdiagc(s, "E0208", (*st).file, (*st).line, (*st).col, "continue outside a loop");
        }
        return;
    }
    if k == S::Return {
        let mut rt: *mut Type = null;
        if (*s).cur_fn != null {
            rt = (*((*s).cur_fn)).ty;
        }
        if (*s).cur_fn != null && (*rt).kind == K::Void {
            if (*st).expr != null {
                sdiagc(s, "E0219", (*st).file, (*st).line, (*st).col, "void function cannot return a value");
            }
        } else if rt != null {
            if (*st).expr == null {
                sdiagc(s, "E0206", (*st).file, (*st).line, (*st).col, "missing return value");
            } else {
                let at: *mut Type = resolve_type(s, check_expr(s, (*st).expr, rt));
                if !type_compat(rt, at) {
                    sdiagc(s, "E0203", (*st).file, (*st).line, (*st).col, "return type mismatch");
                }
            }
        }
        return;
    }
    if k == S::Unsafe {
        (*s).unsafe_depth = (*s).unsafe_depth + 1;
        check_block(s, (*st).body);
        (*s).unsafe_depth = (*s).unsafe_depth - 1;
        return;
    }
    if k == S::Block {
        check_block(s, (*st).body);
        return;
    }
    if k == S::For {
        scope_push(s);
        if (*st).init != null {
            check_stmt(s, (*st).init);
        }
        if (*st).expr != null {
            let bt: *mut Type = type_new((*s).a, K::Bool);
            let ct: *mut Type = resolve_type(s, check_expr(s, (*st).expr, bt));
            if (*ct).kind != K::Bool {
                sdiagc(s, "E0214", (*st).file, (*st).line, (*st).col, "for condition must be bool");
            }
        }
        if (*st).step != null {
            check_stmt(s, (*st).step);
        }
        (*s).loop_depth = (*s).loop_depth + 1;
        check_block(s, (*st).body);
        (*s).loop_depth = (*s).loop_depth - 1;
        scope_pop(s);
        return;
    }
    if k == S::DoWhile {
        (*s).loop_depth = (*s).loop_depth + 1;
        check_block(s, (*st).body);
        (*s).loop_depth = (*s).loop_depth - 1;
        let bt: *mut Type = type_new((*s).a, K::Bool);
        let ct: *mut Type = resolve_type(s, check_expr(s, (*st).expr, bt));
        if (*ct).kind != K::Bool {
            sdiagc(s, "E0214", (*st).file, (*st).line, (*st).col, "do while condition must be bool");
        }
        return;
    }
    if k == S::Label {
        let mut q: *mut Stmt = (*st).body;
        while q != null {
            check_stmt(s, q);
            q = (*q).next;
        }
        return;
    }
    if k == S::Goto {
        if label_find(s, (*st).name) == null {
            sdiag_name(s, (*st).file, (*st).line, (*st).col, "undefined label", (*st).name,
                " (labels are function-local)");
        }
        return;
    }
    if k == S::Switch {
        let ct: *mut Type = resolve_type(s, check_expr(s, (*st).expr, null));
        let kk: K = (*ct).kind;
        if !type_is_int(ct) && kk != K::Enum {
            sdiag(s, (*st).file, (*st).line, (*st).col, "switch requires an integer or enum");
        }
        (*s).switch_depth = (*s).switch_depth + 1;
        let mut c: *mut Case = (*st).cases;
        while c != null {
            if !(*c).is_default && (*c).expr != null {
                let _ = resolve_type(s, check_expr(s, (*c).expr, ct));
                let _ = eval_int(s, (*c).expr);
            }
            check_block(s, (*c).body);
            c = (*c).next;
        }
        (*s).switch_depth = (*s).switch_depth - 1;
        return;
    }

    }
}

fn has_break(st: *mut Stmt) -> bool {
    unsafe {
    let mut p: *mut Stmt = st;
    while p != null {
        let k: S = (*p).kind;
        if k == S::Break {
            return true;
        }
        if k == S::If {
            if has_break((*p).body) || has_break((*p).els) {
                return true;
            }
        }
        if k == S::Unsafe || k == S::Block || k == S::Label {
            if has_break((*p).body) {
                return true;
            }
        }
        p = (*p).next;
    }
    return false;

    }
}

fn last_stmt(head: *mut Stmt) -> *mut Stmt {
    unsafe {
    let mut p: *mut Stmt = head;
    let mut last: *mut Stmt = null;
    while p != null {
        last = p;
        p = (*p).next;
    }
    return last;

    }
}

fn expr_exits(e: *mut Expr) -> bool {
    unsafe {
    if e == null || (*e).kind != E::Call {
        return false;
    }
    if (*e).lhs == null || (*((*e).lhs)).kind != E::Ident {
        return false;
    }
    if rt_eq((*((*e).lhs)).name, "panic") {
        return true;
    }
    if !rt_eq((*((*e).lhs)).name, "syscall") {
        return false;
    }
    let a: *mut Expr = (*e).args;
    if a == null || (*a).kind != E::IntLit {
        return false;
    }
    return (*a).ival == 60 || (*a).ival == 231;

    }
}

fn diverges(st: *mut Stmt) -> bool {
    unsafe {
    if st == null {
        return false;
    }
    let k: S = (*st).kind;
    if k == S::Return {
        return true;
    }
    if k == S::Loop {
        return !has_break((*st).body);
    }
    if k == S::While {
        if (*st).expr != null && (*((*st).expr)).kind == E::BoolLit && (*((*st).expr)).ival != 0 {
            return !has_break((*st).body);
        }
        return false;
    }
    if k == S::If {
        if (*st).els != null {
            return diverges(last_stmt((*st).body)) && diverges((*st).els);
        }
        return false;
    }
    if k == S::Unsafe || k == S::Block {
        return diverges(last_stmt((*st).body));
    }
    if k == S::Label {
        return diverges(last_stmt((*st).body));
    }
    if k == S::Switch {
        let mut has_default: bool = false;
        let mut ok: bool = true;
        let mut c: *mut Case = (*st).cases;
        while c != null {
            if (*c).is_default {
                has_default = true;
            }
            if has_break((*c).body) || !diverges(last_stmt((*c).body)) {
                ok = false;
            }
            c = (*c).next;
        }
        return has_default && ok;
    }
    if k == S::Let {
        return expr_exits((*st).expr);
    }
    if k == S::Expr {
        return expr_exits((*st).expr);
    }
    return false;

    }
}

fn check_fn(s: *mut Sem, d: *mut Decl) {
    unsafe {
    if !(*d).has_body {
        return;
    }
    (*s).cur_fn = d;
    (*s).slot = 0;
    (*s).unsafe_depth = 0;
    (*s).loop_depth = 0;
    (*s).switch_depth = 0;
    (*s).labels = null;
    (*s).cur_module = (*d).unit;
    collect_labels(s, (*d).body);
    scope_push(s);
    let mut p: *mut Param = (*d).params;
    while p != null {
        let pt: *mut Type = resolve_type(s, (*p).ty);
        let vd: *mut Decl = decl_new((*s).a, D::Var, (*p).name, (*d).file, (*d).line, (*d).col);
        (*vd).ty = pt;
        (*vd).is_mut = false;
        (*vd).slot = (*s).slot;
        (*s).slot = (*s).slot + 1;
        (*p).decl = vd;
        scope_add(s, vd);
        p = (*p).next;
    }
    check_block(s, (*d).body);
    scope_pop(s);
    let rt: *mut Type = resolve_type(s, (*d).ty);
    if (*rt).kind != K::Void && !diverges(last_stmt((*d).body)) {
        sdiagc(s, "E0206", (*d).file, (*d).line, (*d).col, "function can reach the end without returning");
    }
    (*s).cur_fn = null;

    }
}

fn resolve_all_types(s: *mut Sem) {
    unsafe {
    let mut d: *mut Decl = (*s).globals;
    while d != null {
        (*s).cur_module = (*d).unit;
        if (*d).kind == D::Func {
            (*d).ty = resolve_type(s, (*d).ty);
            let mut p: *mut Param = (*d).params;
            while p != null {
                (*p).ty = resolve_type(s, (*p).ty);
                p = (*p).next;
            }
        } else if (*d).kind == D::Struct {
            let mut f: *mut Field = (*d).fields;
            while f != null {
                (*f).ty = resolve_type(s, (*f).ty);
                f = (*f).next;
            }
        } else if (*d).kind == D::Global || (*d).kind == D::Const {
            (*d).ty = resolve_type(s, (*d).ty);
        } else if (*d).kind == D::Typedef {
            (*d).ty = resolve_type(s, (*d).ty);
        }
        d = (*d).next;
    }

    }
}

fn layout_all(s: *mut Sem) {
    unsafe {
    let mut d: *mut Decl = (*s).globals;
    while d != null {
        (*s).cur_module = (*d).unit;
        if (*d).kind == D::Struct {
            layout_struct(s, d);
        }
        d = (*d).next;
    }
    (*s).cur_module = "";

    }
}

fn sem_run_ex(a: *mut Arena, d: *mut Diags, srcs: *mut SrcList, prog: *mut Program,
              require_entry: bool) -> *mut Sem {
    unsafe {
    let s: *mut Sem = rt_alloc(a, sizeof(Sem)) as *mut Sem;
    (*s).a = a;
    (*s).d = d;
    (*s).srcs = srcs;
    (*s).prog = prog;
    (*s).globals = null;
    (*s).gtail = null;
    (*s).scope = null;
    (*s).cur_fn = null;
    (*s).unsafe_depth = 0;
    (*s).loop_depth = 0;
    (*s).switch_depth = 0;
    (*s).depth = 0;
    (*s).depth_reported = false;
    (*s).slot = 0;
    (*s).errors = 0;
    (*s).labels = null;
    (*s).cur_module = "";
    // A parse error leaves a partial AST; the oracle stops after parse
    // failure, and walking the fragment risks dereferencing missing nodes.
    if (*d).count > 0 {
        return s;
    }
    let mut it: *mut Item = (*prog).items;
    while it != null {
        if (*it).decl != null {
            sem_add_global(s, (*it).decl);
        }
        it = (*it).next;
    }
    let mut g: *mut Decl = (*s).globals;
    while g != null {
        if (*g).kind == D::Enum {
            let mut v: *mut Variant = (*g).variants;
            let mut next: i64 = 0;
            while v != null {
                if (*v).expr != null {
                    (*v).value = eval_int(s, (*v).expr);
                } else {
                    (*v).value = next;
                }
                next = (*v).value + 1;
                v = (*v).next;
            }
            (*g).size = 4;
            (*g).alignment = 4;
        }
        if (*g).kind == D::Struct && (*g).nfields == 0 {
            sdiagc(s, "E0228", (*g).file, (*g).line, (*g).col, "structs must have at least one field");
        }
        g = (*g).next;
    }
    g = (*s).globals;
    while g != null {
        if (*g).kind == D::Const {
            (*g).ty = resolve_type(s, (*g).ty);
            if (*((*g).ty)).kind == K::Str {
                (*g).cval_kind = 2;
                (*g).cval_s = eval_str(s, (*g).init);
            } else if (*((*g).ty)).kind == K::F32 || (*((*g).ty)).kind == K::F64 {
                (*g).cval_kind = 3;
                (*g).cval = eval_float_bits(s, (*g).init);
            } else if (*((*g).ty)).kind == K::Vec {
                sdiag(s, (*g).file, (*g).line, (*g).col, "vec constants are not supported by the bootstrap compiler");
                (*g).cval_kind = 1;
                (*g).cval = 0;
            } else if (*((*g).ty)).kind == K::Ptr && (*g).init != null
                && (*((*g).init)).kind == E::Unary && (*((*g).init)).op == T::Amp
                && (*((*g).init)).lhs != null && (*((*((*g).init)).lhs)).kind == E::Ident
                && lookup(s, (*((*((*g).init)).lhs)).name) != null
                && (*lookup(s, (*((*((*g).init)).lhs)).name)).kind == D::Global {
                // `const P: *T = &G`: inline the global's address at use sites.
                (*g).cval_kind = 5;
                (*g).cval_s = (*lookup(s, (*((*((*g).init)).lhs)).name)).name;
                (*g).cval = 0;
            } else if (*((*g).ty)).kind == K::Array || (*((*g).ty)).kind == K::Struct
                || (*((*g).ty)).kind == K::Slice {
                sdiagc(s, "E0231", (*g).file, (*g).line, (*g).col, "const values must be scalar, str, or a pointer");
                (*g).cval_kind = 1;
                (*g).cval = 0;
            } else {
                (*g).cval_kind = 1;
                (*g).cval = eval_int(s, (*g).init);
            }
        }
        g = (*g).next;
    }
    resolve_all_types(s);
    layout_all(s);
    let mentry: *mut Decl = sem_find(s, "main");
    let sentry: *mut Decl = sem_find(s, "_start");
    if require_entry {
        if mentry == null && sentry == null {
            sdiagc(s, "E0212", 0, 0, 0, "no entry point: define main or _start");
        }
        if mentry != null && (*mentry).kind == D::Func {
            if (*mentry).nparams != 0 && (*mentry).nparams != 3 {
                sdiagc(s, "E0217", (*mentry).file, (*mentry).line, (*mentry).col, "main must take 0 or 3 parameters");
            }
            if (*mentry).ty != null && (*(*mentry).ty).kind != K::I32 {
                sdiagc(s, "E0217", (*mentry).file, (*mentry).line, (*mentry).col, "main must return i32");
            }
        }
        if sentry != null && (*sentry).kind == D::Func {
            if (*sentry).nparams != 0 {
                sdiagc(s, "E0217", (*sentry).file, (*sentry).line, (*sentry).col, "_start must take no parameters");
            }
            if (*sentry).ty != null && (*(*sentry).ty).kind != K::Void {
                sdiagc(s, "E0217", (*sentry).file, (*sentry).line, (*sentry).col, "_start must return void");
            }
        }
    }
    g = (*s).globals;
    while g != null {
        if (*g).kind == D::Global {
            let gt: *mut Type = resolve_type(s, (*g).ty);
            if (*gt).kind == K::Vec {
                let mut vf: i32 = (*g).file;
                let mut vl: i32 = (*g).line;
                let mut vc: i32 = (*g).col;
                if (*g).init != null {
                    vf = (*((*g).init)).file;
                    vl = (*((*g).init)).line;
                    vc = (*((*g).init)).col;
                }
                sdiagc(s, "E0226", vf, vl, vc, "vec globals are not supported by the bootstrap compiler");
            } else if (*g).init == null {
                sdiag(s, (*g).file, (*g).line, (*g).col, "global requires an initializer");
            } else {
                let at: *mut Type = resolve_type(s, check_expr(s, (*g).init, gt));
                if !type_compat(gt, at) {
                    sdiagc(s, "E0203", (*g).file, (*g).line, (*g).col, "global initializer type mismatch");
                }
                if ((*gt).kind == K::Struct || (*gt).kind == K::Array) && !type_plain(gt) {
                    // `llty` lowers these to `[size x i8]`, which a struct
                    // literal constant cannot initialize.
                    sdiagc(s, "E0226", (*((*g).init)).file, (*((*g).init)).line, (*((*g).init)).col,
                        "static aggregates with packed, union, bitfield, or align(N) layout are not supported by the bootstrap compiler");
                } else if !is_const_expr(s, (*g).init, g) {
                    sdiagc(s, "E0226", (*((*g).init)).file, (*((*g).init)).line, (*((*g).init)).col,
                        "global initializers must be constant expressions");
                }
            }
        }
        g = (*g).next;
    }
    g = (*s).globals;
    while g != null {
        if (*g).kind == D::Func {
            check_fn(s, g);
        }
        g = (*g).next;
    }
    return s;

    }
}

fn sem_run(a: *mut Arena, d: *mut Diags, srcs: *mut SrcList, prog: *mut Program) -> *mut Sem {
    return sem_run_ex(a, d, srcs, prog, true);
}

// `corexc test` compiles a program without an entry point; the harness that
// calls `test_*` functions is generated instead.
fn sem_run_tests(a: *mut Arena, d: *mut Diags, srcs: *mut SrcList, prog: *mut Program) -> *mut Sem {
    return sem_run_ex(a, d, srcs, prog, false);
}
