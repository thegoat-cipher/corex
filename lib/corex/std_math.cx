//! Small, predictable math library. Integer helpers plus the floating-point
//! operations a compiler frontend needs; no libm.

module std_math;

pub fn abs_i64(x: i64) -> i64 {
    if x < 0 {
        return -x;
    }
    return x;
}

pub fn abs_i32(x: i32) -> i32 {
    if x < 0 {
        return -x;
    }
    return x;
}

pub fn min_i64(a: i64, b: i64) -> i64 {
    if a < b {
        return a;
    }
    return b;
}

pub fn max_i64(a: i64, b: i64) -> i64 {
    if a > b {
        return a;
    }
    return b;
}

pub fn min_u64(a: u64, b: u64) -> u64 {
    if a < b {
        return a;
    }
    return b;
}

pub fn max_u64(a: u64, b: u64) -> u64 {
    if a > b {
        return a;
    }
    return b;
}

pub fn clz64(x: u64) -> i32 {
    if x == 0 {
        return 64;
    }
    let mut n: i32 = 0;
    let mut v: u64 = x;
    while (v & 9223372036854775808) == 0 {
        v <<= 1;
        n += 1;
    }
    return n;
}

pub fn ctz64(x: u64) -> i32 {
    if x == 0 {
        return 64;
    }
    let mut n: i32 = 0;
    let mut v: u64 = x;
    while (v & 1) == 0 {
        v >>= 1;
        n += 1;
    }
    return n;
}

pub fn popcount64(x: u64) -> i32 {
    let mut n: i32 = 0;
    let mut v: u64 = x;
    while v != 0 {
        n += (v & 1) as i32;
        v >>= 1;
    }
    return n;
}

pub fn is_pow2(x: u64) -> bool {
    if x == 0 {
        return false;
    }
    return (x & (x - 1)) == 0;
}

pub fn next_pow2(x: u64) -> u64 {
    if x <= 1 {
        return 1;
    }
    let mut v: u64 = 1;
    while v < x {
        v <<= 1;
    }
    return v;
}

pub fn fabs(x: f64) -> f64 {
    if x < 0.0 {
        return -x;
    }
    return x;
}

pub fn sqrt(x: f64) -> f64 {
    if x <= 0.0 {
        return 0.0;
    }
    let mut g: f64 = x;
    if g < 1.0 {
        g = 1.0;
    }
    let mut i: i32 = 0;
    while i < 40 {
        g = 0.5 * (g + x / g);
        i += 1;
    }
    return g;
}

pub fn trunc(x: f64) -> f64 {
    return (x as i64) as f64;
}

pub fn floor(x: f64) -> f64 {
    let t: f64 = trunc(x);
    if t > x {
        return t - 1.0;
    }
    return t;
}

pub fn ceil(x: f64) -> f64 {
    let t: f64 = trunc(x);
    if t < x {
        return t + 1.0;
    }
    return t;
}

pub fn round(x: f64) -> f64 {
    if x < 0.0 {
        return 0.0 - floor(0.0 - x + 0.5);
    }
    return floor(x + 0.5);
}

pub fn powi(x: f64, n: i32) -> f64 {
    let mut result: f64 = 1.0;
    let mut base: f64 = x;
    let mut e: i32 = n;
    if e < 0 {
        base = 1.0 / base;
        e = -e;
    }
    while e > 0 {
        if (e & 1) != 0 {
            result *= base;
        }
        base *= base;
        e >>= 1;
    }
    return result;
}
