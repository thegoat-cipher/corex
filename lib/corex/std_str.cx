//! C-string and CoreX-`str` helpers. CoreX `str` is a `(ptr, len)` value; the
//! C string functions operate on NUL-terminated `cstr`/`*u8` buffers.

module std_str;
mod std_mem;

pub fn strlen(s: cstr) -> usize {
    unsafe {
        let mut n: usize = 0;
        while *((s as *u8) + n) != 0 {
            n += 1;
        }
        return n;
    }
}

pub fn strcmp(a: cstr, b: cstr) -> i32 {
    unsafe {
        let pa: *u8 = a as *u8;
        let pb: *u8 = b as *u8;
        let mut i: usize = 0;
        while *(pa + i) != 0 && *(pb + i) != 0 {
            let x: u8 = *(pa + i);
            let y: u8 = *(pb + i);
            if x != y {
                if x < y { return -1; }
                return 1;
            }
            i += 1;
        }
        let x: u8 = *(pa + i);
        let y: u8 = *(pb + i);
        if x == y { return 0; }
        if x < y { return -1; }
        return 1;
    }
}

pub fn strncmp(a: cstr, b: cstr, n: usize) -> i32 {
    unsafe {
        let pa: *u8 = a as *u8;
        let pb: *u8 = b as *u8;
        let mut i: usize = 0;
        while i < n {
            let x: u8 = *(pa + i);
            let y: u8 = *(pb + i);
            if x != y {
                if x < y { return -1; }
                return 1;
            }
            if x == 0 { return 0; }
            i += 1;
        }
        return 0;
    }
}

pub fn strcpy(dst: *mut u8, src: cstr) -> *mut u8 {
    unsafe {
        let s: *u8 = src as *u8;
        let mut i: usize = 0;
        while *(s + i) != 0 {
            *(dst + i) = *(s + i);
            i += 1;
        }
        *(dst + i) = 0;
        return dst;
    }
}

pub fn strncpy(dst: *mut u8, src: cstr, n: usize) -> *mut u8 {
    unsafe {
        let s: *u8 = src as *u8;
        let mut i: usize = 0;
        while i < n && *(s + i) != 0 {
            *(dst + i) = *(s + i);
            i += 1;
        }
        while i < n {
            *(dst + i) = 0;
            i += 1;
        }
        return dst;
    }
}

pub fn strcat(dst: *mut u8, src: cstr) -> *mut u8 {
    unsafe {
        let mut n: usize = 0;
        while *(dst + n) != 0 {
            n += 1;
        }
        strcpy(dst + n, src);
        return dst;
    }
}

pub fn strchr(s: cstr, value: u8) -> *u8 {
    unsafe {
        let p: *u8 = s as *u8;
        let mut i: usize = 0;
        loop {
            let c: u8 = *(p + i);
            if c == value {
                return p + i;
            }
            if c == 0 {
                return null;
            }
            i += 1;
        }
    }
}

/// CoreX `str` equality (no lookup table, byte comparison).
pub fn str_eq(a: str, b: str) -> bool {
    if len(a) != len(b) {
        return false;
    }
    let mut i: usize = 0;
    while i < len(a) {
        if a[i] != b[i] {
            return false;
        }
        i += 1;
    }
    return true;
}

/// Index of the first occurrence of `needle` in `haystack`, or `usize` max.
pub fn str_find(haystack: str, needle: str) -> usize {
    let hl: usize = len(haystack);
    let nl: usize = len(needle);
    if nl == 0 {
        return 0;
    }
    if nl > hl {
        return 18446744073709551615;
    }
    let mut i: usize = 0;
    while i + nl <= hl {
        let mut j: usize = 0;
        let mut same: bool = true;
        while j < nl {
            if haystack[i + j] != needle[j] {
                same = false;
                break;
            }
            j += 1;
        }
        if same {
            return i;
        }
        i += 1;
    }
    return 18446744073709551615;
}

/// Copy a CoreX `str` into a NUL-terminated buffer.
pub fn str_copy_cstr(dst: *mut u8, cap: usize, s: str) -> cstr {
    unsafe {
        if cap <= len(s) {
            return null;
        }
        let mut i: usize = 0;
        while i < len(s) {
            *(dst + i) = s[i];
            i += 1;
        }
        *(dst + len(s)) = 0;
        return dst as cstr;
    }
}
