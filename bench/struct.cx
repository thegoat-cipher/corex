// CoreX benchmark: array-of-structs updates (layout and field addressing).
// Must match bench/struct.c.

struct Item {
    key: i64,
    value: i64,
    tag: u32,
    pad: u32,
}

fn main() -> i32 {
    let n: usize = 2000000;
    unsafe {
        let items: *mut Item = alloc(n * 24) as *mut Item;
        let mut i: usize = 0;
        while i < n {
            let p: *mut Item = items + i;
            (*p).key = i as i64;
            (*p).value = (i as i64) * 3;
            (*p).tag = 1;
            (*p).pad = 0;
            i += 1;
        }
        let mut sum: i64 = 0;
        i = 0;
        while i < n {
            let p: *mut Item = items + i;
            (*p).value += (*p).key;
            sum += (*p).value;
            i += 1;
        }
        free(items as *mut u8, n * 24);
        return (sum % 256) as i32;
    }
}
