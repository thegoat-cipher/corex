// CoreX benchmark: f64 array multiply-add (vectorizable by LLVM).
// Must match bench/f64.c.

fn main() -> i32 {
    let n: usize = 2000000;
    unsafe {
        let a: *mut f64 = alloc(n * 8) as *mut f64;
        let b: *mut f64 = alloc(n * 8) as *mut f64;
        let mut i: usize = 0;
        while i < n {
            *(a + i) = (i as f64) * 0.5;
            *(b + i) = (i as f64) * 0.25;
            i += 1;
        }
        let mut sum: f64 = 0.0;
        i = 0;
        while i < n {
            sum += *(a + i) * 1.5 + *(b + i);
            i += 1;
        }
        free(a as *mut u8, n * 8);
        free(b as *mut u8, n * 8);
        return (sum as i64 % 256) as i32;
    }
}
