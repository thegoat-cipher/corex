fn main() -> i32 {
    let a: u64 = 18446744073709551615;
    print(a);
    print(a + 1);
    print(7 / 3);
    print(7 % 3);
    print(-7 / 3);
    print(-7 % 3);
    print(1 << 63);
    print((255 as u8) + 1);
    print((-1 as i8) as i32);
    print(3 < 4);
    print(4 <= 3);
    print(true && false);
    print(true || false);
    print(!false);
    return 0;
}
