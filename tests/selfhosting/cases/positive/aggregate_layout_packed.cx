packed struct P { a: u8, b: u32, c: u16 }
struct Bits16 { x: u16: 4, y: u16: 12 }
struct Sbits { x: i8: 4, y: i8: 4 }
union U { a: u32, b: [u8; 4], c: u64 }

fn main() -> i32 {
    print(sizeof(P));
    print(alignof(P));
    print(offsetof(P, a));
    print(offsetof(P, b));
    print(offsetof(P, c));
    print(sizeof(Bits16));
    print(sizeof(Sbits));
    print(sizeof(U));
    print(alignof(U));
    print(offsetof(U, c));

    let mut p: P = P { a: 1, b: 2, c: 3 };
    p.b = 70000;
    p.c = 40000;
    print(p.a);
    print(p.b);
    print(p.c);

    let mut b: Bits16 = Bits16 { x: 9, y: 3000 };
    print(b.x);
    print(b.y);
    b.y = 4095;
    b.x = 15;
    print(b.x);
    print(b.y);

    let mut s: Sbits = Sbits { x: -3, y: 7 };
    print(s.x);
    print(s.y);
    s.x = -8;
    print(s.x);

    let mut u: U = U { c: 4294967296 };
    print(u.a);
    print(u.b[0]);
    print(u.b[3]);
    u.a = 305419896;
    print(u.a);
    print(u.b[3]);
    return 0;
}
